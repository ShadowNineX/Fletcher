map "Fletcher Hybrid Indicator" {
    input a bit at (0, 0)
    input b bit
    wire different bit = a ^ b
    register seen bit = false

    tick {
        next seen = seen | different
    }

    script {
        wire enabled bit = seen
    }

    circuit {
        output indicator bit at (92, 64) = enabled & a
    }

    place wall at (-4, 0) with { color = "blue", glyph = "A" }
}
