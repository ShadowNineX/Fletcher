package main

// x,y is the phase source. A transition on either edge requests
// one note. Stretch the edge to two ticks so a request during a pulse can
// sound on the first available tick.
macro FixedCue(x int, y int, instrument int, octave int, note int) {
    place blueISplitter at (x, y + 1) facing right
    place arrow at (x + 1, y + 1) facing right
    place xor at (x + 2, y + 1) facing right
    place blueISplitter at (x + 3, y + 1) facing right
    place arrow at (x + 4, y + 1) facing right
    place blueLSplitter at (x + 5, y + 1) facing right

    // With stretched request I, pulse[t] = I[t] && (!I[t-1] || pulse[t-2]).
    // The feedback and output ANDs receive the same two signals.
    place not at (x + 5, y + 2) facing right
    place and at (x + 6, y + 1) facing down
    place lSplitter at (x + 6, y + 2) facing right flipped
    place lSplitter at (x + 7, y + 1) facing left flipped
    place and at (x + 7, y + 2) facing down
    place music at (x + 7, y + 3) facing right with { instrument = instrument, octave = octave, note = note }
}

// Two physical banks let consecutive requests reach a new Music Arrow
// in one propagation tick.
macro FastCueVoices(x int, y int, instrument int, octave int, note int) {
    place tSplitter at (x + 3, y + 2) facing down
    place tSplitter at (x + 7, y + 2) facing down
    place music at (x + 3, y + 3) facing right with { instrument = instrument, octave = octave, note = note }
    place music at (x + 7, y + 3) facing right with { instrument = instrument, octave = octave, note = note }
}

macro CommonCueBank(x int, y int) {
    expand FastCueVoices(x,      y, 8, 5, 7)  // Pickup.
    expand CueAccent(x,         y, -1, 8, 4, 7)
    expand FastCueVoices(x + 8,  y, 19, 3, 4) // Damage.
    expand CueAccent(x + 8,     y, -1, 3, 4, 2)
    expand FastCueVoices(x + 16, y, 1, 3, 1)  // Monster.
    expand CueAccent(x + 16,    y, -1, 21, 3, 1)
    expand FastCueVoices(x + 24, y, 18, 3, 7) // Mechanism.
    expand CueAccent(x + 24,    y, -1, 3, 3, 7)
    expand FastCueVoices(x + 32, y, 21, 3, 10) // Impact.
    expand CueAccent(x + 32,    y, -1, 18, 3, 5)
    expand CueAccent(x + 32,    y,  1, 3, 4, 0)
    expand FastCueVoices(x + 40, y, 7, 4, 7)  // Stage.
    expand CueAccent(x + 40,    y, -1, 7, 5, 7)
    expand FastCueVoices(x + 48, y, 3, 4, 6)  // Denied use.
    expand CueAccent(x + 48,    y, -1, 18, 4, 6)
}

// A splitter's side output adds a voice to both banks in the same tick.
macro CueAccent(x int, y int, side int, instrument int, octave int, note int) {
    place music at (x + 3 + side, y + 2) facing right with { instrument = instrument, octave = octave, note = note }
    place music at (x + 7 + side, y + 2) facing right with { instrument = instrument, octave = octave, note = note }
}

macro WeaponCueBank(x int, y int) {
    expand FastCueVoices(x,       y, 3, 4, 0)   // Pistol.
    expand CueAccent(x,           y, -1, 18, 3, 0)
    expand CueAccent(x,           y,  1, 3, 4, 2)
    expand FastCueVoices(x + 8,   y, 3, 3, 7)   // Shotgun.
    expand CueAccent(x + 8,       y, -1, 18, 2, 5)
    expand CueAccent(x + 8,       y,  1, 3, 4, 0)
    expand FastCueVoices(x + 16,  y, 3, 2, 11)  // Super shotgun.
    expand CueAccent(x + 16,      y, -1, 18, 2, 0)
    expand CueAccent(x + 16,      y,  1, 3, 4, 4)
    expand FastCueVoices(x + 24,  y, 18, 5, 1)  // Shotgun cock.
    expand FastCueVoices(x + 32,  y, 18, 4, 9)  // Super shotgun open.
    expand FastCueVoices(x + 40,  y, 18, 4, 11) // Super shotgun load.
    expand FastCueVoices(x + 48,  y, 18, 5, 0)  // Super shotgun close.
    expand FastCueVoices(x + 56,  y, 19, 5, 7)  // Plasma.
    expand CueAccent(x + 56,      y, -1, 3, 4, 7)
    expand FastCueVoices(x + 64,  y, 21, 3, 4)  // BFG.
    expand CueAccent(x + 64,      y, -1, 3, 3, 0)
    expand CueAccent(x + 64,      y,  1, 18, 2, 4)
    expand FastCueVoices(x + 72,  y, 21, 3, 9)  // Chainsaw start.
    expand CueAccent(x + 72,      y, -1, 3, 4, 9)
    expand FastCueVoices(x + 80,  y, 21, 2, 7)  // Chainsaw idle.
    expand FastCueVoices(x + 88,  y, 21, 3, 7)  // Chainsaw swing.
    expand FastCueVoices(x + 96,  y, 21, 2, 11) // Chainsaw hit.
    expand CueAccent(x + 96,      y, -1, 3, 4, 11)
    expand FastCueVoices(x + 104, y, 18, 2, 7)  // Rocket.
    expand CueAccent(x + 104,     y, -1, 3, 3, 0)
    expand CueAccent(x + 104,     y,  1, 3, 4, 7)
    expand FastCueVoices(x + 112, y, 3, 3, 0)   // Punch.
    expand CueAccent(x + 112,     y, -1, 3, 4, 0)
    expand FastCueVoices(x + 120, y, 3, 4, 1)   // Chaingun.
    expand CueAccent(x + 120,     y, -1, 18, 3, 2)
    expand CueAccent(x + 120,     y,  1, 3, 4, 3)
}

macro MenuCueBank(x int, y int) {
    expand FastCueVoices(x,      y, 18, 5, 3) // pstop, move selection.
    expand CueAccent(x,         y, -1, 3, 5, 3)
    expand FastCueVoices(x + 8,  y, 18, 4, 3) // stnmov, slider.
    expand CueAccent(x + 8,     y, -1, 3, 4, 3)
    expand FastCueVoices(x + 16, y, 18, 4, 6) // swtchn, open or back.
    expand CueAccent(x + 16,    y, -1, 3, 4, 6)
    expand FastCueVoices(x + 24, y, 18, 4, 0) // swtchx, dismiss.
    expand CueAccent(x + 24,    y, -1, 3, 3, 0)
    expand FastCueVoices(x + 32, y, 3, 4, 0)  // pistol, select.
    expand CueAccent(x + 32,    y, -1, 18, 3, 0)
}
