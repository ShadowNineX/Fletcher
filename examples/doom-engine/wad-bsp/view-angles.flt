func previewAnglesForView(view engine.ViewProjection) [engine.MaxViewWidth]bits<32> {
    if view.Width == 128 { return previewColumnAngles }
    if view.Width == engine.MaxViewWidth { return previewColumnAngles320 }
    return engine.ViewColumnAngles(view)
}
