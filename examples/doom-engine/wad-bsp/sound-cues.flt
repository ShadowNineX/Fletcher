package main

import "actorinfo"
import "audio"
import "engine"
import "play"
import "wad"

const cueWeapon bits<8> = 1
const cuePickup bits<8> = 2
const cueDamage bits<8> = 4
const cueMonster bits<8> = 8
const cueMechanism bits<8> = 16
const cueImpact bits<8> = 32
const cueStage bits<8> = 64
const cueDenied bits<8> = 128

// The menu chooses a sound by the game tic, then Logic Arrows plays the
// corresponding synthesized cue on the existing physical audio bank.
const episodeQuitSounds = [8]int{57, 26, 27, 31, 35, 36, 38, 52}
const commercialQuitSounds = [8]int{80, 93, 95, 31, 56, 72, 78, 52}

func previewQuitCue(commercial bit, gameTic int) bits<8> {
    index := (gameTic >> 2) & 7
    if commercial { return previewSoundCue(commercialQuitSounds[index]) }
    return previewSoundCue(episodeQuitSounds[index])
}
const previewSoundVolume = 15

func packMusicArrowTone(instrument int, octave int, note int) bits<12> {
    return bits<12>(instrument * 128 + octave * 16 + note)
}

// Lanes correspond to the pre-tuned Music Arrows in WeaponCueBank.
func weaponCueLane(sound int) int {
    switch sound {
    case actorinfo.SoundShotgun: return 1
    case actorinfo.SoundSuperShotgun: return 2
    case 3: return 3 // Shotgun cock.
    case actorinfo.SoundShotgunOpen: return 4
    case actorinfo.SoundShotgunLoad: return 5
    case actorinfo.SoundShotgunClose: return 6
    case 8: return 7 // Plasma.
    case actorinfo.SoundBfg: return 8
    case actorinfo.SoundSawUp: return 9
    case actorinfo.SoundSawIdle: return 10
    case actorinfo.SoundSawMiss: return 11
    case actorinfo.SoundSawHit: return 12
    case 14: return 13 // Rocket launch.
    case actorinfo.SoundPunch: return 14
    case audio.SoundChaingun: return 15
    default: return 0 // Pistol.
    }
}

func weaponCueRequest(sound int) bits<16> {
    return bits<16>(1) << weaponCueLane(sound)
}

func menuCueRequest(sound int) bits<28> {
    switch sound {
    case play.CampaignMenuSoundCursor: return 1 << 23
    case play.CampaignMenuSoundAdjust: return 1 << 24
    case play.CampaignMenuSoundBack: return 1 << 25
    case play.CampaignMenuSoundClose: return 1 << 26
    case play.CampaignMenuSoundSelect: return 1 << 27
    }
    return 0
}

// Convert vanilla sound IDs into short notes the native Music Arrows can
// synthesize. Several effects share a note, and categories can overlap.
func previewSoundCue(id int) bits<8> {
    if id <= 0 || id >= audio.SoundEffectCount { return 0 }
    switch id {
    case 15, 17, 35, 82: return cueImpact // Explosions and teleports.
    case 18, 19, 20, 21, 22, 23, 24, 88, 89: return cueMechanism
    case 25, actorinfo.SoundSlop, actorinfo.SoundPlayerDeath, actorinfo.SoundPlayerHighDeath: return cueDamage
    case 32, 33, 90, 93: return cuePickup
    case actorinfo.SoundOof, actorinfo.SoundNoWay: return cueDenied
    case 83, 86: return cueWeapon
    }
    if id <= 14 { return cueWeapon }
    return cueMonster
}

// Music Arrows play synthesized notes. Use the original audibility rules
// before asking a lane to play a positional actor sound.
func previewActorCue(level wad.BspLevel, actors play.MapActors, sound int, origin int) bits<8> {
    cue := previewSoundCue(sound)
    if cue == 0 || origin == 0 || origin == actors.PlayerActors[0] { return cue }
    listener := actors.ActorAt(actors.PlayerActors[0] - 1)
    source := actors.ActorAt(origin - 1)
    if !listener.Valid || !source.Valid { return 0 }
    if !previewSoundAudible(level, listener.Physics, source.Physics.Body.X, source.Physics.Body.Y) { return 0 }
    return cue
}

func previewSoundAudible(level wad.BspLevel, listener play.ActorPhysics, x int, y int) bit {
    return audio.AdjustSound(audio.SoundPoint{X: listener.Body.X, Y: listener.Body.Y, Angle: listener.Angle},
        audio.SoundPoint{X: x, Y: y}, play.BossMapNumber(level.MapName), previewSoundVolume).Audible
}

type sectorSoundBounds struct {
    Box engine.Box
    Valid bit
}

func (bounds sectorSoundBounds) withLine(line wad.CollisionLine) sectorSoundBounds {
    if !bounds.Valid { bounds.Box = engine.ClearBox() }
    bounds.Box = engine.AddToBox(bounds.Box, line.First.X, line.First.Y)
    bounds.Box = engine.AddToBox(bounds.Box, line.Last.X, line.Last.Y)
    bounds.Valid = true
    return bounds
}

// P_GroupLines centers sector sound origins on the linedef endpoints. Both
// sides contribute. Cache the bounds in one pass over the immutable geometry.
func loadSectorSoundBounds(level wad.BspLevel) play.PagedSlots<sectorSoundBounds> {
    var sectors play.PagedSlots<sectorSoundBounds>
    for index := range level.Lines.Count {
        line := level.LineAt(index)
        if line.Valid {
            sectors = sectors.With(line.FrontSector, sectors.At(line.FrontSector).withLine(line))
            if line.BackSector >= 0 && line.BackSector != line.FrontSector {
                sectors = sectors.With(line.BackSector, sectors.At(line.BackSector).withLine(line))
            }
        }
    }
    return sectors
}

func previewMoverCues(level wad.BspLevel, listener play.ActorPhysics, bounds play.PagedSlots<sectorSoundBounds>, sounds play.MoverSounds) bits<8> {
    var cues bits<8>
    for index := range sounds.Count {
        sound := sounds.At(index)
        cue := previewSoundCue(sound.Id)
        if cue & ~cues != 0 {
            if sound.Sector == play.GlobalMoverSoundSector {
                cues = cues | cue
            } else if sound.Sector >= 0 && sound.Sector < level.Sectors.Count {
                sector := bounds.At(sound.Sector)
                // In P_GroupLines the untouched min/max sentinels average to zero.
                if previewSoundAudible(level, listener,
                    (sector.Box.Right + sector.Box.Left) / 2, (sector.Box.Top + sector.Box.Bottom) / 2) {
                    cues = cues | cue
                }
            }
        }
    }
    return cues
}
