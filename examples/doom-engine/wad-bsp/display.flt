package main

// The compact profile keeps native fixture coordinates and game ticks small.
// Use Width = 320 and Height = 200 for Doom's original framebuffer size.
const Width = 128
const Height = 96
const DitherColors = true
// Starting 3D detail mode. G toggles it in the campaign menu.
const LowDetail = false
// Doom's view size with the status bar visible. Use 3–10 screen blocks.
const ViewBlocks = 10
const ControlRow = Height / 2

// The focus marker sits two tiles left and two rows below the framebuffer.
const previewCameraFocus = "const { x, y } = getPosition();\n" +
    "onStart(() => game.focusCamera(x - 2, -y - 1, -x + 2, y + 16));"
