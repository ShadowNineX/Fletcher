// Single-player status bar layout from linuxdoom-1.10/st_stuff.c.

package main

import "actorinfo"
import "play"
import "wad"
import "walls"

const statusBarHeight = 32
const statusBarTop = intermissionHeight - statusBarHeight

// statusName packs an eight-byte WAD name without allocating a string. Doom
// patch names are ASCII and WAD name comparison ignores trailing zero bytes.
func statusName(a int, b int, c int, d int, e int, f int, g int, h int) wad.LumpName {
    return wad.LumpName{Low: a | (b << 8) | (c << 16) | (d << 24),
        High: e | (f << 8) | (g << 16) | (h << 24)}
}

func statusBarName() wad.LumpName { return statusName(83, 84, 66, 65, 82, 0, 0, 0) } // STBAR

func statusTallNumberName(digit int) wad.LumpName {
    return statusName(83, 84, 84, 78, 85, 77, 48 + digit, 0) // STTNUMn
}

func statusShortNumberName(digit int) wad.LumpName {
    return statusName(83, 84, 89, 83, 78, 85, 77, 48 + digit) // STYSNUMn
}

func statusGrayNumberName(digit int) wad.LumpName {
    return statusName(83, 84, 71, 78, 85, 77, 48 + digit, 0) // STGNUMn
}

func statusKeyName(key int) wad.LumpName {
    return statusName(83, 84, 75, 69, 89, 83, 48 + key, 0) // STKEYSn
}

func statusFaceName(index int) wad.LumpName {
    if index == play.StatusGodFace { return statusName(83, 84, 70, 71, 79, 68, 48, 0) } // STFGOD0
    if index == play.StatusDeadFace { return statusName(83, 84, 70, 68, 69, 65, 68, 48) } // STFDEAD0
    if index < 0 || index >= play.StatusGodFace { return wad.LumpName{} }
    pain, pose := index / play.StatusFaceStride, index % play.StatusFaceStride
    switch pose {
    case 0, 1, 2:
        return statusName(83, 84, 70, 83, 84, 48 + pain, 48 + pose, 0) // STFSTpn
    case 3: return statusName(83, 84, 70, 84, 82, 48 + pain, 48, 0) // STFTRp0
    case 4: return statusName(83, 84, 70, 84, 76, 48 + pain, 48, 0) // STFTLp0
    case 5: return statusName(83, 84, 70, 79, 85, 67, 72, 48 + pain) // STFOUCHp
    case 6: return statusName(83, 84, 70, 69, 86, 76, 48 + pain, 0) // STFEVLp
    default: return statusName(83, 84, 70, 75, 73, 76, 76, 48 + pain) // STFKILLp
    }
}

func statusTallDigit(mounts wad.Archives, digit int) IntermissionPatch {
    if digit < 0 || digit > 9 { return IntermissionPatch{} }
    return readIntermissionPatch(mounts, statusTallNumberName(digit))
}

func statusShortDigit(mounts wad.Archives, digit int) IntermissionPatch {
    if digit < 0 || digit > 9 { return IntermissionPatch{} }
    return readIntermissionPatch(mounts, statusShortNumberName(digit))
}

func statusDigit(mounts wad.Archives, digit int, tall bit) IntermissionPatch {
    if tall { return statusTallDigit(mounts, digit) }
    return statusShortDigit(mounts, digit)
}

func drawStatusReadout(patch IntermissionPatch, shade walls.WadShading, x int, y int, tall bit) {
    ink := color.Yellow
    if tall { ink = color.White }
    drawPatchWithInk(patch, shade, x, y, false, CleanStatusBar, ink)
}

func drawStatusNumber(mounts wad.Archives, shade walls.WadShading, value int, x int, y int,
    digits int, tall bit) {
    if value < 0 || digits <= 0 { return }
    zero := statusDigit(mounts, 0, tall)
    if zero.Width == 0 { return }
    for range digits {
        digit := value % 10
        x = x - zero.Width
        drawStatusReadout(statusDigit(mounts, digit, tall), shade, x, y, tall)
        value = value / 10
        if value == 0 { return }
    }
}

func drawStatusPercent(mounts wad.Archives, shade walls.WadShading, value int, x int, y int) {
    drawStatusReadout(readIntermissionPatch(mounts,
        statusName(83, 84, 84, 80, 82, 67, 78, 84)), shade, x, y, true) // STTPRCNT
    drawStatusNumber(mounts, shade, value, x, y, 3, true)
}

func statusKey(inventory play.PlayerInventory, color int) int {
    if inventory.Cards[color + play.CardBlueSkull] { return color + play.CardBlueSkull }
    if inventory.Cards[color] { return color }
    return -1
}

func drawStatusWeapon(mounts wad.Archives, shade walls.WadShading, inventory play.PlayerInventory,
    index int, x int, y int) {
    digit := index + 2
    name := statusGrayNumberName(digit)
    if inventory.Weapons[index + 1] { name = statusShortNumberName(digit) }
    drawIntermissionPatch(readIntermissionPatch(mounts, name), shade, x, y)
}

func statusBarCompatible(patch IntermissionPatch) bit {
    return patch.Width == intermissionWidth && patch.Height == statusBarHeight && patch.Left == 0 && patch.Top == 0
}

// StatusBarAvailable checks the backing patch. Individual widgets are optional.
func StatusBarAvailable(mounts wad.Archives) bit {
    return statusBarCompatible(readIntermissionPatch(mounts, statusBarName()))
}

// DrawStatusBar draws Doom's single-player STBAR over native screen rows
// 168..199. drawIntermissionPatch projects those rows to the 128x96 preview.
func DrawStatusBar(mounts wad.Archives, shade walls.WadShading, inventory play.PlayerInventory, faceIndex int) {
    statusBar := readIntermissionPatch(mounts, statusBarName())
    if !statusBarCompatible(statusBar) || !shade.Valid { return }
    if CleanStatusBar {
        for row := range Height - StatusViewHeight {
            for column := range Width { pixel(column, StatusViewHeight + row, true, color.Black) }
        }
        if Width >= 160 && Height >= 120 {
            labelY := Height - campaignGlyphHeight
            drawCampaignText("AMMO", 10 * Width / intermissionWidth, labelY, color.Orange)
            drawCampaignText("HEALTH", 53 * Width / intermissionWidth, labelY, color.Orange)
            drawCampaignText("ARMOR", 184 * Width / intermissionWidth, labelY, color.Orange)
        }
    } else { drawIntermissionPatch(statusBar, shade, 0, statusBarTop) }

    weapon := actorinfo.WeaponAt(inventory.ReadyWeapon)
    if weapon.Valid && weapon.Ammo >= 0 && weapon.Ammo < play.AmmoCount {
        drawStatusNumber(mounts, shade, inventory.Ammo[weapon.Ammo], 44, 171, 3, true)
    }
    drawStatusPercent(mounts, shade, inventory.Health, 90, 171)

    drawIntermissionPatch(readIntermissionPatch(mounts, statusName(83, 84, 65, 82, 77, 83, 0, 0)), shade, 104, statusBarTop) // STARMS
    for index := range 6 {
        drawStatusWeapon(mounts, shade, inventory, index, 111 + (index % 3) * 12, 172 + (index / 3) * 10)
    }

    drawIntermissionPatch(readIntermissionPatch(mounts, statusFaceName(faceIndex)), shade, 143, statusBarTop)
    drawStatusPercent(mounts, shade, inventory.Armor, 221, 171)

    for color := range 3 {
        key := statusKey(inventory, color)
        if key >= 0 { drawIntermissionPatch(readIntermissionPatch(mounts, statusKeyName(key)), shade, 239, 171 + color * 10) }
    }
    for ammoIndex := range play.AmmoCount {
        y := 173 + ammoIndex * 6
        if ammoIndex == play.AmmoCell { y = 191 }
        if ammoIndex == play.AmmoMissile { y = 185 }
        drawStatusNumber(mounts, shade, inventory.Ammo[ammoIndex], 288, y, 3, false)
        drawStatusNumber(mounts, shade, inventory.MaxAmmo[ammoIndex], 314, y, 3, false)
    }
}
