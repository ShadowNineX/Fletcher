package main

import "audio"
import "wad"

const notePhase bits<13> = 4096
const musicBunny = 30
const instrumentFamilies = [16]int{0, 8, 6, 2, 1, 17, 17, 16, 11, 13, 20, 20, 20, 2, 8, 21}

func previewLevelMusic(name wad.LumpName) int {
    number := ((name.Low >> 24) & 255) - 48
    if name.Low & 0xffffff == 0x50414d {
        return audio.LevelMusic(true, 1, number * 10 + (name.High & 255) - 48)
    }
    episode := ((name.Low >> 8) & 255) - 48
    return audio.LevelMusic(false, episode, number)
}

func musicArrowInstrument(program int, channel int) int {
    if channel == 15 { return 3 } // MUS percussion channel.
    switch program {
    case 42: return 10 // Cello
    case 43: return 12 // Contrabass
    case 46: return 7 // Harp
    case 47: return 18 // Timpani
    case 57: return 5 // Trombone
    case 58: return 4 // Tuba
    case 60: return 14 // Horn
    case 68: return 15 // Oboe
    case 70: return 9 // Bassoon
    case 80: return 19 // Square lead
    case 81: return 21 // Saw lead
    }
    return instrumentFamilies[program / 8]
}

func packetForMusicNote(previous bits<13>, note audio.MusNote) bits<13> {
    // Quantize pitch bend to the nearest semitone the Music Arrow can play.
    bend := note.Bend - 128
    if bend < 0 { bend = bend - 32 } else { bend = bend + 32 }
    key := note.Key
    if note.Channel != 15 { key = key + bend / 64 }
    if key < 0 { key = 0 }
    octave := key / 12 - 1
    if octave < 0 { octave = 0 }
    if octave > 7 { octave = 7 }
    packed := bits<13>(packMusicArrowTone(musicArrowInstrument(note.Program, note.Channel), octave, key % 12))
    return packed | ((previous ^ notePhase) & notePhase)
}

// Voices sit five columns apart. Each has two physical Music Arrows. The
// phase bit alternates the destination so repeated notes still get a fresh
// power edge even when the next logical tick finishes immediately.
macro SoundtrackBank(x int, y int) {
    place arrow at (x, y) facing right
    place music at (x + 1, y) facing right with { octave = 4 }
}

macro SoundtrackVoice(x int, y int) {
    expand SoundtrackBank(x, y)
    expand SoundtrackBank(x + 2, y)
}

const soundtrackSource = "const { x, y } = getPosition();\n" +
    "always(() => {\n" +
    "    const tick = world.getTick() - 1;\n" +
    "    const frame = tick % 2 === 0 ? globalState.__fletcherEven : globalState.__fletcherOdd;\n" +
    "    const packets = tick >= 0 && frame?.t === tick ? frame.p?.soundtrackNotes : undefined;\n" +
    "    const voiceCount = packets?.length ?? state.voiceCount ?? 0;\n" +
    "    state.voiceCount = voiceCount;\n" +
    "    let phases = state.phases ?? 0;\n" +
    "    const previouslyActive = state.active ?? 0;\n" +
    "    let active = 0;\n" +
    "    const tones = state.tones ?? (state.tones = []);\n" +
    "    for (let voice = 0; voice < voiceCount; voice++) {\n" +
    "        const mask = 1 << voice;\n" +
    "        const previousPhase = (phases & mask) !== 0;\n" +
    "        const voiceX = x + 5 * voice;\n" +
    "        if ((previouslyActive & mask) !== 0) world.setSignal(voiceX + (previousPhase ? 0 : 2), y, 0);\n" +
    "        if (!packets) continue;\n" +
    "        const packet = packets[voice];\n" +
    "        const phase = (packet & 4096) !== 0;\n" +
    "        if (phase === previousPhase) continue;\n" +
    "        phases ^= mask;\n" +
    "        active |= mask;\n" +
    "        const bank = voice * 2 + (phase ? 0 : 1);\n" +
    "        const driverX = voiceX + (phase ? 0 : 2);\n" +
    "        const extra = (((packet & 4095) >> 7) << 8) | (packet & 127);\n" +
    "        if (extra !== tones[bank]) {\n" +
    "            world.setArrow(driverX + 1, y, 29, 1, false, extra);\n" +
    "            tones[bank] = extra;\n" +
    "        }\n" +
    "        world.setSignal(driverX, y, 1);\n" +
    "    }\n" +
    "    state.phases = phases;\n" +
    "    state.active = active;\n" +
    "});"
