package walls

import "engine"
import "wad"

// PaletteDither is a compact ordered-dither pattern. Coverage is the number
// of the sixteen Bayer cells painted with Second; the rest use First.
type PaletteDither struct {
    First color
    Second color
    Coverage int
}

// A shading snapshot copies three scalar arrays instead of cloning one
// PaletteDither record per color. Raster loops still choose the same swatches.
type DitheredPalette struct {
    First [wad.PaletteColors]color
    Second [wad.PaletteColors]color
    Coverage [wad.PaletteColors]int
}

type nativeSwatch struct {
    Shade color
    Red int
    Green int
    Blue int
}

func paletteSwatch(index int) nativeSwatch {
    switch index {
    case 0: return nativeSwatch{Shade: color.Black}
    case 1: return nativeSwatch{Shade: color.Red, Red: 255}
    case 2: return nativeSwatch{Shade: color.Orange, Red: 255, Green: 128}
    case 3: return nativeSwatch{Shade: color.Yellow, Red: 255, Green: 255}
    case 4: return nativeSwatch{Shade: color.Green, Green: 255}
    case 5: return nativeSwatch{Shade: color.Blue, Blue: 255}
    case 6: return nativeSwatch{Shade: color.Purple, Red: 128, Blue: 128}
    case 7: return nativeSwatch{Shade: color.White, Red: 255, Green: 255, Blue: 255}
    }
    return nativeSwatch{Shade: color.Black}
}

// Keep purple for actual violet/blue pixels.  In particular, it must never
// compete for Doom's common red-orange-brown texture ramp.
func swatchAllowed(index int, red int, green int, blue int) bit {
    if index != 6 { return true }
    return red > green && blue > green
}

func liftedChannel(value int) int {
    // A deliberately modest toe lift keeps the darkest WAD shades legible on
    // the tile display without changing 0 or 255 (and thus pure primaries).
    return value + value * (255 - value) / 2048
}

func clampCoverage(value int) int {
    if value < 0 { return 0 }
    if value > 16 { return 16 }
    return value
}

func grayDither(red int, green int, blue int) PaletteDither {
    brightness := (red * 77 + green * 150 + blue * 29) / 256
    return PaletteDither{First: color.Black, Second: color.White, Coverage: clampCoverage((brightness * 16 + 127) / 255)}
}

func gammaPaletteColor(source wad.PaletteSet, row int, index int, gamma int) wad.PaletteColor {
    rgb := wad.SamplePalette(source, row, index)
    if rgb.Valid {
        rgb.Red, rgb.Green, rgb.Blue = engine.DoomGammaByte(gamma, rgb.Red),
            engine.DoomGammaByte(gamma, rgb.Green), engine.DoomGammaByte(gamma, rgb.Blue)
    }
    return rgb
}

func ProjectDitheredPalette(source wad.PaletteSet, row int) DitheredPalette {
    return projectDitheredPalette(source, row, engine.DefaultDoomGamma)
}

// Convert a PLAYPAL row when its tint or gamma changes. Per-pixel drawing
// selects a precomputed pair with a 4x4 pattern.
func projectDitheredPalette(source wad.PaletteSet, row int, gamma int) DitheredPalette {
    var result DitheredPalette
    for sourceIndex := range wad.PaletteColors {
        rgb := gammaPaletteColor(source, row, sourceIndex, gamma)
        var pattern PaletteDither
        if !rgb.Valid {
            pattern = PaletteDither{First: color.Black, Second: color.Black}
        } else {
            red, green, blue := liftedChannel(int(rgb.Red)), liftedChannel(int(rgb.Green)), liftedChannel(int(rgb.Blue))
            // Neutrals are always black/white. This is both more readable and
            // prevents the old purple bias in concrete, metal, and darkness.
            delta := red - green
            if delta < 0 { delta = -delta }
            other := green - blue
            if other < 0 { other = -other }
            edge := red - blue
            if edge < 0 { edge = -edge }
            if delta <= 12 && other <= 12 && edge <= 12 {
                pattern = grayDither(red, green, blue)
            } else {
                bestError := 2147483647
                best := PaletteDither{First: color.Black, Second: color.Black}
                for firstIndex := range 8 {
                    first := paletteSwatch(firstIndex)
                    if swatchAllowed(firstIndex, red, green, blue) {
                        for secondIndex := range 8 {
                            second := paletteSwatch(secondIndex)
                            if swatchAllowed(secondIndex, red, green, blue) {
                                dr, dg, db := second.Red - first.Red, second.Green - first.Green, second.Blue - first.Blue
                                length := dr * dr + dg * dg + db * db
                                coverage := 0
                                if length != 0 {
                                    numerator := (red - first.Red) * dr + (green - first.Green) * dg + (blue - first.Blue) * db
                                    coverage = clampCoverage((numerator * 16 + length / 2) / length)
                                }
                                mixRed := (first.Red * (16 - coverage) + second.Red * coverage) / 16
                                mixGreen := (first.Green * (16 - coverage) + second.Green * coverage) / 16
                                mixBlue := (first.Blue * (16 - coverage) + second.Blue * coverage) / 16
                                errorRed, errorGreen, errorBlue := red - mixRed, green - mixGreen, blue - mixBlue
                                error := errorRed * errorRed + errorGreen * errorGreen + errorBlue * errorBlue
                                if error < bestError {
                                    bestError = error
                                    best = PaletteDither{First: first.Shade, Second: second.Shade, Coverage: coverage}
                                }
                            }
                        }
                    }
                }
                pattern = best
            }
        }
        result.First[sourceIndex] = pattern.First
        result.Second[sourceIndex] = pattern.Second
        result.Coverage[sourceIndex] = pattern.Coverage
    }
    return result
}

const Bayer4 = [16]int{
    0, 8, 2, 10,
    12, 4, 14, 6,
    3, 11, 1, 9,
    15, 7, 13, 5,
}

func DitheredColor(pattern PaletteDither, x int, y int) color {
    if Bayer4[((y & 3) << 2) | (x & 3)] < pattern.Coverage { return pattern.Second }
    return pattern.First
}
