// Opaque tier texture alignment and drawing adapted from r_segs.c and r_draw.c.

package walls

import "engine"
import "wad"

const ColumnCacheSlots = 128

type WallTier struct {
    Texture wad.TextureDef
    Middle int
}

type WallTextureFrame struct {
    Texture wad.TextureDef
    OriginalHeight int
}

type WallMaterials struct {
    Middle WallTier
    Upper WallTier
    Lower WallTier
    middleAbsent bit
    upperAbsent bit
    lowerAbsent bit
    Masked WallTier
    OffsetU int
    Light int
    ExtraLight int
    Shade WadShading
    Textured bit
}

// Opaque tiers peg against the original sidedef texture's height. Masked
// middle textures use the translated frame's height in R_RenderMaskedSegRange.
func resolveWallTexture(materials Materials, name wad.LumpName) WallTextureFrame {
    index := wad.TextureIndex(materials.Textures, name)
    texture := wad.TextureAt(materials.Textures, index)
    result := WallTextureFrame{Texture: texture, OriginalHeight: texture.Height}
    if texture.Valid && materials.Animations.Count > 0 && materials.LevelTime >= 0 {
        frame := wad.AnimatedTextureIndex(materials.Animations, index, materials.LevelTime)
        if frame != index { result.Texture = wad.TextureAt(materials.Textures, frame) }
    }
    return result
}

func ResolveWallMaterials(materials Materials, wall wad.WallSegment, sidedef wad.SideMaterial, eye int) WallMaterials {
    result := WallMaterials{OffsetU: sidedef.OffsetU, Light: wall.Light, ExtraLight: materials.ExtraLight, Shade: materials.Shade}
    if wall.First.Y == wall.Last.Y {
        result.ExtraLight = result.ExtraLight - 1
    } else if wall.First.X == wall.Last.X {
        result.ExtraLight = result.ExtraLight + 1
    }
    if !wall.TwoSided {
        middleFrame := resolveWallTexture(materials, sidedef.Middle)
        result.middleAbsent = !middleFrame.Texture.Valid && wad.IsEmptyWallTexture(materials.Textures, sidedef.Middle)
        middle := wall.Front.Ceiling - eye
        if sidedef.PegBottom { middle = wall.Front.Floor + (middleFrame.OriginalHeight << 16) - eye }
        result.Middle = WallTier{Texture: middleFrame.Texture, Middle: middle + sidedef.OffsetV}
    } else {
        texture := resolveWallTexture(materials, sidedef.Middle).Texture
        if texture.Valid {
            top := wall.Front.Ceiling
            if wall.Back.Ceiling < top { top = wall.Back.Ceiling }
            if sidedef.PegBottom {
                floor := wall.Front.Floor
                if wall.Back.Floor > floor { floor = wall.Back.Floor }
                top = floor + (texture.Height << 16)
            }
            result.Masked = WallTier{Texture: texture, Middle: top - eye + sidedef.OffsetV}
        }
        // A reserved texture is intentionally empty. A missing named texture
        // in a partial WAD can still use the diagnostic fallback color.
        if !wall.SharedSky && wall.Back.Ceiling < wall.Front.Ceiling {
            upperFrame := resolveWallTexture(materials, sidedef.Upper)
            result.upperAbsent = !upperFrame.Texture.Valid && wad.IsEmptyWallTexture(materials.Textures, sidedef.Upper)
            top := wall.Back.Ceiling + (upperFrame.OriginalHeight << 16)
            if sidedef.PegTop { top = wall.Front.Ceiling }
            result.Upper = WallTier{Texture: upperFrame.Texture, Middle: top - eye + sidedef.OffsetV}
        }
        if wall.Back.Floor > wall.Front.Floor {
            texture := resolveWallTexture(materials, sidedef.Lower).Texture
            result.lowerAbsent = !texture.Valid && wad.IsEmptyWallTexture(materials.Textures, sidedef.Lower)
            top := wall.Back.Floor
            if sidedef.PegBottom {
                top = wall.Front.Ceiling
                if wall.SharedSky { top = wall.Back.Ceiling }
            }
            result.Lower = WallTier{Texture: texture, Middle: top - eye + sidedef.OffsetV}
        }
    }
    result.Textured = result.Middle.Texture.Valid || result.Upper.Texture.Valid || result.Lower.Texture.Valid || result.Masked.Texture.Valid
    return result
}

type TextureColumnRef interface {
    ReadColumn() wad.TextureColumn
}

type CachedTextureColumn struct {
    Data wad.TextureColumn
}

func (entry CachedTextureColumn) ReadColumn() wad.TextureColumn { return entry.Data }

type textureColumnSource interface {
    ColumnAt(column int) wad.TextureColumn
}

type WallTextureRun struct {
    Bounds engine.ColumnSpan
    Columns [engine.MaxViewWidth]int
    Scale engine.WallScale
    Height int
    Width int
    Sky bit
}

func drawTextureRows(column wad.TextureColumn, shading WadShading, x int, first int, end int, fraction int, step int,
    light int, fallback color) {
    table := shading.ColorMaps.Offset + light * wad.ColorMapBytes
    maps, patch := shading.ColorMaps.File, column.DirectPatch.File
    detailShift := shading.DetailShift
    x = shading.ScreenX + (x << detailShift)
    screenTop := shading.ScreenY + first
    patternColumn, nextPatternColumn := x & 3, (x + 1) & 3
    dithered := shading.Dithered
    // A missing row breaks the run of indexed pixels. Matching source
    // indices can reuse lighting and swatches even across different rows.
    previousRow, previousSource, index, coverage := -1, -1, 0, 0
    var firstSwatch color
    var secondSwatch color
    for dy := range end - first {
        row := (fraction >> 16) & 127
        if row != previousRow {
            previousRow = row
            source := -1
            if column.DirectRaw && row < column.Height {
                source = int(patch[column.DirectOffset + row])
            } else if column.Valid && column.Direct {
                sample := wad.TextureColumnPixel(column, row)
                if sample.Covered { source = int(sample.Value) }
            } else if column.Valid && column.Covered[row >> 5][row & 31] {
                source = int(bits<8>(column.PackedPixels[row >> 2] >> ((row & 3) << 3)))
            }
            if source != previousSource {
                previousSource = source
                if source >= 0 {
                    index = int(maps[table + source])
                    if dithered {
                        firstSwatch = shading.Patterns.First[index]
                        secondSwatch = shading.Patterns.Second[index]
                        coverage = shading.Patterns.Coverage[index]
                    } else { firstSwatch = shading.Palette[index] }
                }
            }
        }
        if previousSource >= 0 {
            y := screenTop + dy
            swatch, adjacent := firstSwatch, firstSwatch
            if dithered {
                patternRow := (y & 3) << 2
                if Bayer4[patternRow | patternColumn] < coverage { swatch = secondSwatch }
                if detailShift != 0 && Bayer4[patternRow | nextPatternColumn] < coverage { adjacent = secondSwatch }
            }
            pixel(x, y, true, swatch, index)
            if detailShift != 0 { pixel(x + 1, y, true, adjacent, index) }
        } else {
            pixel(x, screenTop + dy, true, fallback)
            if detailShift != 0 { pixel(x + 1, screenTop + dy, true, fallback) }
        }
        fraction = fraction + step
    }
}

func drawTextureRun(run WallTextureRun, tier WallTier, materials WallMaterials, rows [engine.MaxViewWidth]bits<32>,
    fallback color, cache ColumnCache) ColumnCache {
    var cached [ColumnCacheSlots]TextureColumnRef
    var keys [ColumnCacheSlots]int
    var columns textureColumnSource
    prepared := false
    mask := wad.TextureColumnWidthMask(tier.Texture)
    lastScale, step, light := 0, 0, 0
    var lightRows bytes
    lightBase := -1
    if !run.Sky { lightRows, lightBase = materials.Shade.WallLightTable(materials.Light, materials.ExtraLight) }
    if run.Sky { step = (engine.DoomScreenWidth * engine.FracUnit / run.Width) >> materials.Shade.DetailShift }
    for offset := range run.Bounds.End - run.Bounds.First {
        x := run.Bounds.First + offset
        packed := rows[x]
        if packed != 0 {
            wrapped := run.Columns[x] & mask
            slot := wrapped & (ColumnCacheSlots - 1)
            if keys[slot] != wrapped + 1 {
                keys[slot] = wrapped + 1
                var entry TextureColumnRef
                found := false
                if cache.Enabled { entry, found = cache.Lookup(tier.Texture, wrapped) }
                if !found {
                    if !prepared {
                        columns = wad.PrepareTextureColumns(tier.Texture)
                        prepared = true
                    }
                    entry = CachedTextureColumn{Data: columns.ColumnAt(wrapped)}
                    if cache.Enabled { cache = cache.Store(tier.Texture, wrapped, entry) }
                }
                cached[slot] = entry
            }
            first, end := int(packed >> 16), int(packed & 0xffff)
            scale := run.Scale.First + offset * run.Scale.Step
            if !run.Sky && scale != lastScale {
                step = int(bits<32>(0xffffffff) / bits<32>(scale))
                light = materials.Shade.FixedRow
                if light == 0 {
                    if lightBase >= 0 {
                        index := int(bits<32>(scale) >> engine.LightScaleShift)
                        if index >= engine.MaxLightScale { index = engine.MaxLightScale - 1 }
                        light = int(lightRows[lightBase + index])
                    } else {
                        light = engine.WallLightRow(materials.Light, materials.ExtraLight, scale, run.Width, materials.Shade.DetailShift)
                    }
                }
                lastScale = scale
            }
            fraction := tier.Middle + (first - run.Height / 2) * step
            drawTextureRows(cached[slot].ReadColumn(), materials.Shade, x, first, end, fraction, step, light, fallback)
        }
    }
    return cache
}
