package walls

import "engine"
import "numeric"

const WallHeightBits = 12
const WallHeightUnit = 4096

type Surface struct {
    Front engine.SectorHeights
    Back engine.SectorHeights
    Solid bit
    TwoSided bit
    FrontSky bit
    SharedSky bit
    MarkCeiling bit
    MarkFloor bit
    Shade color
    Materials WallMaterials
}

// The view's projection is shared by every wall in the frame.
type WallView struct {
    Height int
    HasAngles bit
    ColumnAngles [engine.MaxViewWidth]bits<32>
}

type HeightEdge struct {
    Row int
    Step int
}

func makeEdge(worldZ int, cameraZ int, center int, scale engine.WallScale) HeightEdge {
    relative := (worldZ - cameraZ) >> 4
    return HeightEdge{Row: center - cport.C_FixedMul(relative, scale.First), Step: -cport.C_FixedMul(relative, scale.Step)}
}

func paintColumn(column int, first int, end int, shade color, view engine.ViewProjection) {
    x := view.ScreenX + (column << view.DetailShift)
    top := first + view.ScreenY
    for dy := range end - first {
        pixel(x, top + dy, true, shade)
        if view.DetailShift != 0 { pixel(x + 1, top + dy, true, shade) }
    }
}

func recordDrawSegment(coverage engine.ColumnCoverage, segment engine.DrawSegment, surface Surface, eyeZ int,
    run WallTextureRun, shading WadShading) engine.ColumnCoverage {
    front, back := surface.Front, surface.Back
    if !surface.TwoSided || back.Floor >= front.Ceiling {
        segment.Top, segment.TopClosed, segment.TopHeight = true, true, -2147483648
    } else if front.Ceiling < back.Ceiling {
        segment.Top, segment.TopHeight = true, front.Ceiling
    } else if back.Ceiling < eyeZ {
        segment.Top, segment.TopHeight = true, -2147483648
    }
    if !surface.TwoSided || back.Ceiling <= front.Floor {
        segment.Bottom, segment.BottomClosed, segment.BottomHeight = true, true, 2147483647
    } else if front.Floor > back.Floor {
        segment.Bottom, segment.BottomHeight = true, front.Floor
    } else if back.Floor > eyeZ {
        segment.Bottom, segment.BottomHeight = true, 2147483647
    }
    if surface.Materials.Masked.Texture.Valid {
        if !segment.Top { segment.Top, segment.TopHeight = true, -2147483648 }
        if !segment.Bottom { segment.Bottom, segment.BottomHeight = true, 2147483647 }
        segment.Masked = true
        segment.Mask = MaskedWall{Run: run, Tier: surface.Materials.Masked, Shade: shading,
            Light: surface.Materials.Light, ExtraLight: surface.Materials.ExtraLight, Clips: coverage.Rows,
            Closed: segment.TopClosed || segment.BottomClosed}
    }
    if !segment.Top && !segment.Bottom { return coverage }
    if (segment.Top && !segment.TopClosed) || (segment.Bottom && !segment.BottomClosed) {
        segment.ClipRows = engine.PlaneRows{Values: coverage.Rows}
    }
    coverage.DrawSegments = coverage.DrawSegments.Append(segment)
    return coverage
}

func paintRun(camera engine.Camera, wall engine.WallDistance, projection engine.WallTextureProjection,
    rangeSegment engine.DrawSegment, surface Surface, view WallView, coverage engine.ColumnCoverage,
    shading WadShading, cache ColumnCache) (engine.ColumnCoverage, ColumnCache) {
    span := rangeSegment.Span
    height := view.Height
    var scale engine.WallScale
    if view.HasAngles {
        scale = engine.ScaleWallSpanFromAngles(camera, wall, span, view.ColumnAngles[span.First], view.ColumnAngles[span.End - 1])
    } else { scale = engine.ScaleWallSpan(camera, wall, span) }
    center := (height / 2) << WallHeightBits
    frontCeiling := surface.Front.Ceiling
    if surface.SharedSky { frontCeiling = surface.Back.Ceiling }
    top := makeEdge(frontCeiling, camera.Z, center, scale)
    bottom := makeEdge(surface.Front.Floor, camera.Z, center, scale)
    upper := surface.TwoSided && !surface.Materials.upperAbsent && surface.Back.Ceiling < frontCeiling
    lower := surface.TwoSided && !surface.Materials.lowerAbsent && surface.Back.Floor > surface.Front.Floor
    var high HeightEdge
    var low HeightEdge
    if upper { high = makeEdge(surface.Back.Ceiling, camera.Z, center, scale) }
    if lower { low = makeEdge(surface.Back.Floor, camera.Z, center, scale) }
    markCeiling := (surface.Solid || surface.MarkCeiling) && (frontCeiling > camera.Z || surface.FrontSky)
    markFloor := (surface.Solid || surface.MarkFloor) && surface.Front.Floor < camera.Z
    ceiling, floor := -1, -1
    var ceilingRows [engine.MaxViewWidth]bits<32>
    var floorRows [engine.MaxViewWidth]bits<32>
    var ceilingRaster engine.VisplaneRaster
    var floorRaster engine.VisplaneRaster
    ceilingWritten, floorWritten := false, false
    // A wall has either an opaque middle tier or an upper tier.
    var middleOrUpperPixels [engine.MaxViewWidth]bits<32>
    var lowerPixels [engine.MaxViewWidth]bits<32>
    middleOrUpperBand := engine.ColumnSpan{First: span.End, End: span.First}
    lowerBand := engine.ColumnSpan{First: span.End, End: span.First}
    opaqueMiddle := !surface.TwoSided && !surface.Materials.middleAbsent
    textured := surface.Materials.Textured
    middleTexture := surface.Materials.Middle.Texture.Valid
    upperTexture := surface.Materials.Upper.Texture.Valid
    lowerTexture := surface.Materials.Lower.Texture.Valid
    maskedTexture := surface.Materials.Masked.Texture.Valid
    var run WallTextureRun
    if textured {
        run.Bounds, run.Scale, run.Height, run.Width = span, scale, height, camera.View.Width
    }
    if markCeiling && coverage.CeilingPlane != 0 {
        coverage.Planes, ceiling = engine.CheckPlaneRange(coverage.Planes, coverage.CeilingPlane - 1, span.First, span.End)
        if ceiling < 0 { coverage.Failed = true; return coverage, cache }
        coverage.CeilingPlane = ceiling + 1
        ceilingRaster = coverage.Planes.RasterAt(ceiling)
    }
    if markFloor && coverage.FloorPlane != 0 {
        coverage.Planes, floor = engine.CheckPlaneRange(coverage.Planes, coverage.FloorPlane - 1, span.First, span.End)
        if floor < 0 { coverage.Failed = true; return coverage, cache }
        coverage.FloorPlane = floor + 1
        if floor != ceiling { floorRaster = coverage.Planes.RasterAt(floor) }
    }
    sharedPlane := floor >= 0 && floor == ceiling

    for relative := range span.End - span.First {
        column := span.First + relative
        textureColumn := maskedTexture
        clipTop, clipEnd := 0, height
        open := coverage.Rows[column]
        // Zero means untouched. Nonzero entries store the half-open row range
        // still visible through every nearer portal, including empty ranges.
        if open != 0 {
            clipTop = int(open >> 16) - 1
            clipEnd = int(open & 0xffff)
        }
        from := (top.Row + WallHeightUnit - 1) >> WallHeightBits
        end := (bottom.Row >> WallHeightBits) + 1
        if from < clipTop { from = clipTop }
        if end > clipEnd { end = clipEnd }

        // Record the plane fragments while the nearer portal's clipping is
        // still in force. Wall tiers then narrow the opening for deeper walls.
        ceilingFragment := ceiling >= 0 && clipTop < clipEnd && from > clipTop
        floorFragment := floor >= 0 && clipTop < clipEnd && end < clipEnd
        if ceilingFragment || (sharedPlane && floorFragment) {
            if !ceilingWritten && ceilingRaster.HasRows { ceilingRows = ceilingRaster.Rows.ReadRows() }
            ceilingWritten = true
            first, last := clipTop, from
            // With a shared sky plane, Doom's floor write replaces the
            // ceiling at this column only when the floor has visible rows.
            if sharedPlane && floorFragment {
                first, last = end, clipEnd
                if first < clipTop { first = clipTop }
            }
            if last > clipEnd { last = clipEnd }
            ceilingRows[column] = (bits<32>(first) << 16) | bits<32>(last)
            word := column >> 5
            mask := bits<32>(1) << (column & 31)
            ceilingRaster.Words[word] = ceilingRaster.Words[word] | mask
        }
        if floorFragment && !sharedPlane {
            if !floorWritten && floorRaster.HasRows { floorRows = floorRaster.Rows.ReadRows() }
            floorWritten = true
            first := end
            if first < clipTop { first = clipTop }
            floorRows[column] = (bits<32>(first) << 16) | bits<32>(clipEnd)
            word := column >> 5
            mask := bits<32>(1) << (column & 31)
            floorRaster.Words[word] = floorRaster.Words[word] | mask
        }

        if opaqueMiddle {
            if middleTexture {
                if from < end {
                    middleOrUpperPixels[column] = (bits<32>(from) << 16) | bits<32>(end)
                    if middleOrUpperBand.First == span.End { middleOrUpperBand.First = column }
                    middleOrUpperBand.End = column + 1
                    textureColumn = true
                }
            } else {
                paintColumn(column, from, end, surface.Shade, camera.View)
            }
        } else {
            if upper {
                bandEnd := (high.Row >> WallHeightBits) + 1
                if bandEnd > clipEnd { bandEnd = clipEnd }
                if upperTexture {
                    if from < bandEnd {
                        middleOrUpperPixels[column] = (bits<32>(from) << 16) | bits<32>(bandEnd)
                        if middleOrUpperBand.First == span.End { middleOrUpperBand.First = column }
                        middleOrUpperBand.End = column + 1
                        textureColumn = true
                    }
                } else {
                    paintColumn(column, from, bandEnd, surface.Shade, camera.View)
                }
                clipTop = from
                if bandEnd > clipTop { clipTop = bandEnd }
                high.Row = high.Row + high.Step
            } else if markCeiling {
                clipTop = from
            }
            if lower {
                bandStart := (low.Row + WallHeightUnit - 1) >> WallHeightBits
                if bandStart < clipTop { bandStart = clipTop }
                if lowerTexture {
                    if bandStart < end {
                        lowerPixels[column] = (bits<32>(bandStart) << 16) | bits<32>(end)
                        if lowerBand.First == span.End { lowerBand.First = column }
                        lowerBand.End = column + 1
                        textureColumn = true
                    }
                } else {
                    paintColumn(column, bandStart, end, surface.Shade, camera.View)
                }
                clipEnd = end
                if bandStart < clipEnd { clipEnd = bandStart }
                low.Row = low.Row + low.Step
            } else if markFloor {
                clipEnd = end
            }
            if clipTop < 0 { clipTop = 0 } else if clipTop > height { clipTop = height }
            if clipEnd < 0 { clipEnd = 0 } else if clipEnd > height { clipEnd = height }
            coverage.Rows[column] = (bits<32>(clipTop + 1) << 16) | bits<32>(clipEnd)
        }
        top.Row = top.Row + top.Step
        bottom.Row = bottom.Row + bottom.Step
        if textured && textureColumn {
            run.Columns[column] = engine.WallTextureColumn(projection, view.ColumnAngles[column])
        }
    }
    if textured && middleOrUpperBand.First < middleOrUpperBand.End {
        tier := surface.Materials.Upper
        if opaqueMiddle { tier = surface.Materials.Middle }
        cache = drawTextureRun(run, tier, shading, surface.Materials.Light, surface.Materials.ExtraLight,
            middleOrUpperPixels, middleOrUpperBand, surface.Shade, cache)
    }
    if textured && lowerBand.First < lowerBand.End {
        cache = drawTextureRun(run, surface.Materials.Lower, shading, surface.Materials.Light, surface.Materials.ExtraLight,
            lowerPixels, lowerBand, surface.Shade, cache)
    }
    if ceilingWritten {
        ceilingRaster.Rows, ceilingRaster.HasRows = engine.PlaneRows{Values: ceilingRows}, true
        coverage.Planes = coverage.Planes.WithRaster(ceiling, ceilingRaster)
    }
    if floorWritten {
        floorRaster.Rows, floorRaster.HasRows = engine.PlaneRows{Values: floorRows}, true
        coverage.Planes = coverage.Planes.WithRaster(floor, floorRaster)
    }
    if coverage.TrackDrawSegments || maskedTexture {
        rangeSegment.ScaleFirst, rangeSegment.ScaleLast = scale.First, scale.Last
        coverage = recordDrawSegment(coverage, rangeSegment, surface, camera.Z, run, shading)
    }
    return coverage, cache
}

type ProjectedWall struct {
    Span engine.ColumnSpan
    FirstAngle bits<32>
}

// Empty spans include walls hidden by nearer solid columns. Open portals
// leave those columns available to both opaque tiers and masked textures.
func ProjectWall(camera engine.Camera, coverage engine.ColumnCoverage, first engine.Vertex, last engine.Vertex) ProjectedWall {
    firstAngle := engine.PointToAngle(camera.X, camera.Y, first.X, first.Y)
    lastAngle := engine.PointToAngle(camera.X, camera.Y, last.X, last.Y)
    return ProjectWallFromAngles(camera, coverage, firstAngle, lastAngle)
}

func ProjectWallFromAngles(camera engine.Camera, coverage engine.ColumnCoverage, firstAngle bits<32>,
    lastAngle bits<32>) ProjectedWall {
    span := engine.WallColumns(camera.View, camera.Heading, firstAngle, lastAngle)
    if !engine.SpanOpen(coverage, span) { return ProjectedWall{} }
    return ProjectedWall{Span: span, FirstAngle: firstAngle}
}

func DrawProjectedWall(camera engine.Camera, coverage engine.ColumnCoverage, first engine.Vertex, last engine.Vertex,
    direction bits<32>, surface Surface, view WallView, projected ProjectedWall, shading WadShading) engine.ColumnCoverage {
    drawn, _ := DrawProjectedWallCached(camera, coverage, first, last, direction, surface, view, projected, shading, ColumnCache{})
    return drawn
}

func DrawProjectedWallCached(camera engine.Camera, coverage engine.ColumnCoverage, first engine.Vertex, last engine.Vertex,
    direction bits<32>, surface Surface, view WallView, projected ProjectedWall, shading WadShading,
    cache ColumnCache) (engine.ColumnCoverage, ColumnCache) {
    span, firstAngle := projected.Span, projected.FirstAngle
    coverage.StoredWallRange = false
    if span.First >= span.End { return coverage, cache }

    wall := engine.PrepareWall(camera, first, direction, firstAngle)
    var projection engine.WallTextureProjection
    if surface.Materials.Textured {
        projection = engine.PrepareWallTexture(wall, camera.Heading, firstAngle, surface.Materials.OffsetU)
    }
    remaining := span
    for range span.End - span.First {
        open := engine.NextOpenSpan(coverage, remaining)
        if open.First >= open.End {
            if surface.Solid { return engine.CoverSpan(coverage, span), cache }
            return coverage, cache
        }
        clipped := engine.DrawSegment{Span: open, First: first, Last: last}
        coverage, cache = paintRun(camera, wall, projection, clipped, surface, view, coverage, shading, cache)
        if coverage.Failed { return coverage, cache }
        coverage.StoredWallRange = true
        remaining.First = open.End + 1
    }
    if surface.Solid { return engine.CoverSpan(coverage, span), cache }
    return coverage, cache
}

func DrawWall(camera engine.Camera, coverage engine.ColumnCoverage, first engine.Vertex, last engine.Vertex,
    direction bits<32>, surface Surface, view WallView, shading WadShading) engine.ColumnCoverage {
    return DrawProjectedWall(camera, coverage, first, last, direction, surface, view, ProjectWall(camera, coverage, first, last), shading)
}

func DrawSolidWall(camera engine.Camera, coverage engine.ColumnCoverage, first engine.Vertex, last engine.Vertex, direction bits<32>,
    heights engine.SectorHeights, height int, shade color) engine.ColumnCoverage {
    return DrawWall(camera, coverage, first, last, direction, Surface{Front: heights, Solid: true, Shade: shade},
        WallView{Height: height}, WadShading{})
}
