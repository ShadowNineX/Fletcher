func KindForThing(number int) int {
    if number < 0 { return -1 }
    for i := range ActorKindCount {
        if ActorValues[i * ActorFieldCount] == number { return i }
    }
    return -1
}

func KindAt(kind int) ActorDef {
    if kind < 0 || kind >= ActorKindCount { return ActorDef{} }
    offset := kind * ActorFieldCount
    return ActorDef{
        Valid: true,
        DoomedNum: ActorValues[offset],
        SpawnState: ActorValues[offset + 1],
        SpawnHealth: ActorValues[offset + 2],
        SeeState: ActorValues[offset + 3],
        SeeSound: ActorValues[offset + 4],
        ReactionTime: ActorValues[offset + 5],
        AttackSound: ActorValues[offset + 6],
        PainState: ActorValues[offset + 7],
        PainChance: ActorValues[offset + 8],
        PainSound: ActorValues[offset + 9],
        MeleeState: ActorValues[offset + 10],
        MissileState: ActorValues[offset + 11],
        DeathState: ActorValues[offset + 12],
        XDeathState: ActorValues[offset + 13],
        DeathSound: ActorValues[offset + 14],
        Speed: ActorValues[offset + 15],
        Radius: ActorValues[offset + 16],
        Height: ActorValues[offset + 17],
        Mass: ActorValues[offset + 18],
        Damage: ActorValues[offset + 19],
        ActiveSound: ActorValues[offset + 20],
        RaiseState: ActorValues[offset + 21],
        Flags: bits<32>(ActorValues[offset + 22]),
    }
}

func StateAt(state int) StateDef {
    if state < 0 || state >= ActorStateCount { return StateDef{} }
    if state >= StateFirstBankCount {
        offset := (state - StateFirstBankCount) * StateFieldCount
        return StateDef{
            Valid: true,
            Sprite: StateValuesB[offset],
            Frame: StateValuesB[offset + 1],
            Tics: StateValuesB[offset + 2],
            Action: StateValuesB[offset + 3],
            Next: StateValuesB[offset + 4],
            Misc1: StateValuesB[offset + 5],
            Misc2: StateValuesB[offset + 6],
        }
    }
    offset := state * StateFieldCount
    return StateDef{
        Valid: true,
        Sprite: StateValuesA[offset],
        Frame: StateValuesA[offset + 1],
        Tics: StateValuesA[offset + 2],
        Action: StateValuesA[offset + 3],
        Next: StateValuesA[offset + 4],
        Misc1: StateValuesA[offset + 5],
        Misc2: StateValuesA[offset + 6],
    }
}

func WeaponAt(weapon int) WeaponDef {
    if weapon < 0 || weapon >= 9 { return WeaponDef{} }
    offset := weapon * 6
    return WeaponDef{
        Valid: true,
        Ammo: WeaponValues[offset],
        Up: WeaponValues[offset + 1],
        Down: WeaponValues[offset + 2],
        Ready: WeaponValues[offset + 3],
        Attack: WeaponValues[offset + 4],
        Flash: WeaponValues[offset + 5],
    }
}

func SpriteNameLow(sprite int) int {
    if sprite < 0 || sprite >= 138 { return 0 }
    return SpriteNames[sprite]
}
