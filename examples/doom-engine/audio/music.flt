const MusicEpisodeStart = 1
const MusicCommercialStart = 33
const MusicEpisodeIntermission = 28
const MusicCommercialIntermission = 67
const episodeFourMusic = [9]int{22, 20, 21, 5, 16, 13, 15, 14, 9}

