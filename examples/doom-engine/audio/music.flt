func MusicLumpName(id int) wad.LumpName {
    if id <= 0 || id >= MusicCount { return wad.LumpName{} }
    return wad.LumpName{Low: musicLow[id], High: musicHigh[id]}
}

func LevelMusic(commercial bit, episode int, mapNumber int) int {
    if mapNumber < 1 { return 0 }
    if commercial {
        if mapNumber > 32 { return 0 }
        return MusicCommercialStart + mapNumber - 1
    }
    if episode < 1 || episode > 4 || mapNumber > 9 { return 0 }
    if episode == 4 { return episodeFourMusic[mapNumber - 1] }
    return MusicEpisodeStart + (episode - 1) * 9 + mapNumber - 1
}

func IntermissionMusic(commercial bit) int {
    if commercial { return MusicCommercialIntermission }
    return MusicEpisodeIntermission
}
