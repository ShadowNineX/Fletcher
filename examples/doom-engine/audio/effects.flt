type SoundEffect struct {
    Valid bit
    LumpName wad.LumpName
    Priority int
    Pitch int
    VolumeAdjustment int
    Singular bit
    ExclusiveVoice bit
}

func SoundEffectAt(id int) SoundEffect {
    if id <= 0 || id >= SoundEffectCount { return SoundEffect{} }
    sample, pitch := id, NormalPitch
    if id == SoundChaingun { sample, pitch = SoundPistol, 150 }
    return SoundEffect{Valid: true, LumpName: wad.LumpName{Low: soundLow[sample], High: soundHigh[sample]},
        Priority: soundPriority[id], Pitch: pitch, Singular: soundSingularity[id],
        ExclusiveVoice: id == SoundPistol || id == SoundStoneMove || (id >= SoundSawUp && id <= SoundSawHit)}
}

func LoadSoundEffect(mounts wad.Archives, effect SoundEffect) SoundSample {
    if !effect.Valid { return SoundSample{} }
    lump := mounts.Find(effect.LumpName)
    if !lump.Valid { lump = mounts.Find(wad.LumpName{Low: soundLow[SoundPistol], High: soundHigh[SoundPistol]}) }
    return LoadSoundSample(lump)
}
