// Subsector sector lookup from linuxdoom-1.10/p_setup.c and r_main.c.

package wad

import "engine"

type MapSector struct {
    Valid bit
    Index int
    Subsector int
    Heights engine.SectorHeights
}

func (level BspLevel) SubsectorSector(index int) MapSector {
    if index < 0 || index >= level.Subsectors.Count ||
        !recordLumpInFile(level.File, level.Subsectors, SubsectorSize) ||
        !recordLumpInFile(level.File, level.Segs, SegSize) ||
        !recordLumpInFile(level.File, level.Lines, LineSize) ||
        !recordLumpInFile(level.File, level.Sides, SideSize) ||
        !recordLumpInFile(level.File, level.Sectors, SectorSize) { return MapSector{} }

    leaf := level.SubsectorAt(index)
    if leaf.SegmentCount <= 0 || leaf.FirstSegment < 0 ||
        leaf.FirstSegment > level.Segs.Count - leaf.SegmentCount { return MapSector{} }
    segment := level.Segs.Offset + leaf.FirstSegment * SegSize
    line, side := U16(level.File, segment + 6), U16(level.File, segment + 8)
    if line >= level.Lines.Count || side > 1 { return MapSector{} }

    frontSide := sideOffset(level, level.Lines.Offset + line * LineSize, side)
    sector := sideSector(level, frontSide)
    if sector < 0 { return MapSector{} }
    return MapSector{Valid: true, Index: sectorId(level, sector), Subsector: index, Heights: level.sectorHeightsAtOffset(sector)}
}

func (level BspLevel) SectorAtPoint(x int, y int) MapSector {
    if !recordLumpInFile(level.File, level.Nodes, NodeSize) { return MapSector{} }
    return level.SubsectorSector(engine.PointInPartition(level, level.SubsectorCount(), x, y))
}

func (level BspLevel) SectorHasSkyCeiling(sector int) bit {
    return sector >= 0 && sector < level.Sectors.Count &&
        recordLumpInFile(level.File, level.Sectors, SectorSize) &&
        skyFlatAt(level.File, level.Sectors.Offset + sector * SectorSize + 12)
}

func (level BspLevel) SectorLight(sector int) int {
    if sector < 0 || sector >= level.Sectors.Count || !recordLumpInFile(level.File, level.Sectors, SectorSize) { return 0 }
    return signed16(U16(level.File, level.Sectors.Offset + sector * SectorSize + 20))
}

func (level BspLevel) SectorSpecial(sector int) int {
    if sector < 0 || sector >= level.Sectors.Count || !recordLumpInFile(level.File, level.Sectors, SectorSize) { return 0 }
    action := signed16(U16(level.File, level.Sectors.Offset + sector * SectorSize + 22))
    if level.Modified { return level.Changes.ReadSectorSpecial(sector, action) }
    return action
}

func (level BspLevel) SectorTag(sector int) int {
    if sector < 0 || sector >= level.Sectors.Count || !recordLumpInFile(level.File, level.Sectors, SectorSize) { return 0 }
    return signed16(U16(level.File, level.Sectors.Offset + sector * SectorSize + 24))
}
