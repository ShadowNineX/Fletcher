// Indexed equivalent of the forward lookup in linuxdoom-1.10/r_data.c.

package wad

func (set TextureSet) IndexKey(index int) indexKey {
    lump, local := set.First, index
    if index >= set.FirstCount { lump, local = set.Second, index - set.FirstCount }
    offset := textureOffset(lump, local)
    if offset < 0 { return indexKey{} }
    return indexKey{Name: normalizeName(lumpNameAt(lump.File, lump.Offset + offset)), Found: true}
}

func (set TextureSet) CanIndexNames() bit { return set.Valid }

func (set TextureSet) NameIndexReady() bit { return set.Valid && set.indexed == TextureCount(set) }

// BuildNameIndex processes up to batch definitions in their original order.
// TextureIndex uses its forward scan while this index is being built.
func (set TextureSet) BuildNameIndex(batch int) TextureSet {
    if !set.CanIndexNames() || set.NameIndexReady() || batch <= 0 { return set }
    count := TextureCount(set) - set.indexed
    if batch < count { count = batch }
    var names nameIndexRef = set.names
    if set.indexed == 0 { names = newNameIndex() }
    // Keep the first matching definition, including texture zero and a
    // named header whose dimensions will fail validation.
    set.names = names.Extend(set, set.indexed, count, false)
    set.indexed = set.indexed + count
    return set
}
