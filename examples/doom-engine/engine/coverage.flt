package engine

const CoverageWords = 10

type PlaneColumnBuffer interface {
    ReadRows() [MaxViewWidth]bits<32>
}

type PlaneRows struct {
    Values [MaxViewWidth]bits<32>
}

func (rows PlaneRows) ReadRows() [MaxViewWidth]bits<32> { return rows.Values }

type ColumnCoverage struct {
    Words [CoverageWords]bits<32>
    Rows [MaxViewWidth]bits<32>
    Planes Visplanes
    FloorPlane int
    CeilingPlane int
    TrackDrawSegments bit
    // Set when the last wall had a column range left after solid clipping.
    StoredWallRange bit
    DrawSegments DrawSegmentStore
    Failed bit
}

// The active plane cursors are one-based so zero means no plane. R_Subsector
// chooses both cursors again even if two adjacent leaves share a plane.
func BeginSubsectorPlanes(coverage ColumnCoverage, eye int, floor PlaneKey, ceiling PlaneKey) ColumnCoverage {
    coverage.FloorPlane, coverage.CeilingPlane = 0, 0
    drawFloor, drawCeiling := floor.Height < eye, ceiling.Height > eye || ceiling.Sky
    if coverage.Planes.Failed && (drawFloor || drawCeiling) {
        coverage.Failed = true
        return coverage
    }
    if drawFloor {
        key := normalizedPlaneKey(floor)
        bucket := planeKeyBucket(key)
        index := findPlaneIndex(coverage.Planes, key, bucket)
        if index < 0 { coverage.Planes, index = newVisplane(coverage.Planes, key, MaxViewWidth, 0, bucket) }
        coverage.FloorPlane = index + 1
    }
    if drawCeiling {
        key := normalizedPlaneKey(ceiling)
        bucket := planeKeyBucket(key)
        index := findPlaneIndex(coverage.Planes, key, bucket)
        if index < 0 { coverage.Planes, index = newVisplane(coverage.Planes, key, MaxViewWidth, 0, bucket) }
        coverage.CeilingPlane = index + 1
    }
    return coverage
}

func spanMask(span ColumnSpan, word int) bits<32> {
    first := span.First - word * 32
    end := span.End - word * 32
    var mask bits<32> = 0xffffffff
    if first > 0 { mask = mask << first }
    if end < 32 { mask = mask & ((bits<32>(1) << end) - 1) }
    return mask
}

func validSpan(span ColumnSpan) bit {
    return span.First >= 0 && span.End <= MaxViewWidth && span.First < span.End
}

func ColumnOpen(coverage ColumnCoverage, column int) bit {
    if column < 0 || column >= MaxViewWidth { return false }
    return !coverage.Words[column / 32][column % 32]
}

func SpanOpen(coverage ColumnCoverage, span ColumnSpan) bit {
    if !validSpan(span) { return false }
    first, last := span.First / 32, (span.End - 1) / 32
    for i := range last - first + 1 {
        word := first + i
        if spanMask(span, word) & ~coverage.Words[word] != 0 { return true }
    }
    return false
}

// Find the next clear run without stepping through each pixel column.
func NextOpenSpan(coverage ColumnCoverage, span ColumnSpan) ColumnSpan {
    if !validSpan(span) { return ColumnSpan{} }
    firstWord, lastWord := span.First / 32, (span.End - 1) / 32
    begin := span.End
    for offset := range lastWord - firstWord + 1 {
        word := firstWord + offset
        mask := spanMask(span, word)
        covered := coverage.Words[word] & mask
        if begin == span.End {
            open := mask & ~covered
            if open != 0 {
                bitIndex := firstSetColumnBit(open)
                begin = word * 32 + bitIndex
                covered = covered & (0xffffffff << bitIndex)
            }
        }
        if begin < span.End && covered != 0 {
            return ColumnSpan{First: begin, End: word * 32 + firstSetColumnBit(covered)}
        }
    }
    return ColumnSpan{First: begin, End: span.End}
}

func firstSetColumnBit(mask bits<32>) int {
    index := 0
    if mask & 0xffff == 0 { index = 16; mask = mask >> 16 }
    if mask & 0xff == 0 { index = index + 8; mask = mask >> 8 }
    if mask & 0xf == 0 { index = index + 4; mask = mask >> 4 }
    if mask & 3 == 0 { index = index + 2; mask = mask >> 2 }
    if mask & 1 == 0 { index = index + 1 }
    return index
}

// Mark an opaque wall after drawing its visible columns. Open portals leave
// the horizontal coverage alone, allowing farther walls through the gap.
func CoverSpan(coverage ColumnCoverage, span ColumnSpan) ColumnCoverage {
    if !validSpan(span) { return coverage }
    first, last := span.First / 32, (span.End - 1) / 32
    for i := range last - first + 1 {
        word := first + i
        coverage.Words[word] = coverage.Words[word] | spanMask(span, word)
    }
    return coverage
}

// Bounding box deltas are in BOXTOP, BOXBOTTOM, BOXLEFT, BOXRIGHT order.
const boxCorners = [11][4]int{
    [4]int{3, 0, 2, 1}, [4]int{3, 0, 2, 0}, [4]int{3, 1, 2, 0}, [4]int{},
    [4]int{2, 0, 2, 1}, [4]int{}, [4]int{3, 1, 3, 0}, [4]int{},
    [4]int{2, 0, 3, 1}, [4]int{2, 1, 3, 1}, [4]int{2, 1, 3, 0},
}

func BoxVisible(view ViewProjection, heading bits<32>, x int, y int, bounds Box, coverage ColumnCoverage) bit {
    boxX, boxY := 1, 1
    if x <= bounds.Left { boxX = 0 } else if x >= bounds.Right { boxX = 2 }
    if y >= bounds.Top { boxY = 0 } else if y <= bounds.Bottom { boxY = 2 }
    position := boxY * 4 + boxX
    if position == 5 { return true }

    coordinates := [4]int{bounds.Top, bounds.Bottom, bounds.Left, bounds.Right}
    corners := boxCorners[position]
    left := PointToAngle(x, y, coordinates[corners[0]], coordinates[corners[1]]) - heading
    right := PointToAngle(x, y, coordinates[corners[2]], coordinates[corners[3]]) - heading
    span := left - right
    if span >= angle180 { return true }
    return SpanOpen(coverage, clipAngularSpan(view, left, right, span))
}
