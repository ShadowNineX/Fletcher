// Plane movement and actor height updates from linuxdoom-1.10 p_floor.c and p_map.c.

package play

import "wad"

type MoverFrame struct {
    Valid bit
    Changed bit
    State LevelSpecials
    Player MapActor
    World CombatWorld
    Callback WalkoverContext
    ActorsChanged bit
    DamageSound int
    PickupSound int
    PickupMessage int
    Sounds MoverSounds
}

type MoverOwner struct {
    Door int
    Floor int
    Ceiling int
}

func (owner MoverOwner) Occupied() bit { return owner.Door >= 0 || owner.Floor >= 0 || owner.Ceiling >= 0 }

// specialdata is a single pointer. A donut can overwrite it on its ring
// while leaving the old thinker scheduled. Completion of either thinker
// clears the pointer, so the last assignment or release wins.
func moverOwner(doors LevelDoors, floors LevelFloors, ceilings LevelCeilings, sector int) MoverOwner {
    empty := MoverOwner{Door: -1, Floor: -1, Ceiling: -1}
    owner := empty
    latest := floors.History.entryAt(sector).Released
    ceilingRelease := doors.CeilingHistory.entryAt(sector).Released
    if ceilingRelease > latest { latest = ceilingRelease }
    door := doors.newestActive(sector)
    if door > 0 {
        mover := doors.EntryAt(door)
        if mover.Order + 1 > latest {
            latest = mover.Order + 1
            owner = MoverOwner{Door: door, Floor: -1, Ceiling: -1}
        }
    }
    floor := floors.newestActive(sector)
    if floor > 0 {
        mover := floors.EntryAt(floor)
        if mover.Order + 1 > latest {
            latest = mover.Order + 1
            owner = MoverOwner{Door: -1, Floor: floor, Ceiling: -1}
        }
    }
    handle := ceilings.FindSector(sector)
    for range ceilings.Count {
        if handle == 0 { return owner }
        slot := ceilings.thinkers.slotAt(handle)
        if slot.Entry.Motion.Active {
            if slot.Entry.Order + 1 > latest { return MoverOwner{Door: -1, Floor: -1, Ceiling: handle} }
            return owner
        }
        handle = slot.OlderInSector
    }
    return owner
}

func (state LevelSpecials) MoverOccupied(sector int) bit {
    return moverOwner(state.Doors, state.Floors, state.Ceilings, sector).Occupied()
}

func moverPosition(level wad.BspLevel, blocks wad.BlockMapInfo, player MapActor) MapPositionCheck {
    if blocks.Valid { return CheckMapPosition(level, blocks, player, player.X, player.Y) }
    // The fixed camera has no block lists and only sees its own sector.
    sector := level.SectorAtPoint(player.X, player.Y)
    return MapPositionCheck{Valid: sector.Valid, Floor: sector.Heights.Floor, Ceiling: sector.Heights.Ceiling}
}

func (state LevelSpecials) withCeilingHeight(sector int, height int) LevelSpecials {
    if state.Doors.Count > 0 { state.Doors = state.Doors.withCeiling(sector, height) }
    if state.Ceilings.Count > 0 { state.Ceilings = state.Ceilings.withHeight(sector, height) }
    return state
}

func (state LevelSpecials) recordCeilingRelease(sector int, height int) LevelSpecials {
    released := state.Doors.NextMover + 1
    state.Doors.NextMover = released
    state.Doors.CeilingHistory = state.Doors.CeilingHistory.withEntry(sector,
        retiredCeiling{Height: height, Released: released}, released)
    return state
}

type moverContext struct {
    Base wad.BspLevel
    Blocks wad.BlockMapInfo
    PlayerHandle int
    LevelTime int
    Rules CombatRules
    Actions WalkoverTelefrag
}

type moverPlane struct {
    Sector int
    Height int
    Destination int
    Speed int
    Direction int
    Ceiling bit
    Crush bit
}

func (plane moverPlane) step(blocked bit) PlaneStep {
    return MoveSectorPlane(plane.Height, plane.Speed, plane.Destination, plane.Direction, plane.Ceiling, plane.Crush, blocked)
}

func (plane moverPlane) apply(state LevelSpecials, height int) LevelSpecials {
    if plane.Ceiling { return state.withCeilingHeight(plane.Sector, height) }
    state.Floors = state.Floors.withHeight(plane.Sector, height)
    return state
}

func moveSectorActors(context moverContext, frame MoverFrame, sector int, crush bit) SectorChange {
    state := WalkoverState{Level: frame.State.ApplyTo(context.Base), Specials: frame.State, World: frame.World,
        Callback: frame.Callback}
    return ChangeSector(state, context.Blocks, sector, context.LevelTime, crush, context.Rules, context.Actions)
}

func (frame MoverFrame) withActorChange(change SectorChange, player int) MoverFrame {
    frame.Valid = !change.State.Failed
    frame.World, frame.State = change.State.World, change.State.Specials
    frame.Callback = change.State.Callback
    frame.State.Lighting.Random = frame.World.Random
    frame.Player = frame.World.Actors.ActorAt(player - 1).Physics.Body
    frame.ActorsChanged = frame.ActorsChanged || change.Changed
    if change.DamageSound != 0 { frame.DamageSound = change.DamageSound }
    if change.PickupSound != 0 { frame.PickupSound = change.PickupSound }
    if change.PickupMessage != 0 { frame.PickupMessage = change.PickupMessage }
    return frame
}

type moverTransition struct {
    Frame MoverFrame
    Blocked bit
}

// A blocked move tests the restored plane again. Both passes may change
// actors. A non-terminal crushing move retains its attempted height.
func moveLevelPlane(context moverContext, frame MoverFrame, plane moverPlane) moverTransition {
    if plane.Direction != -1 && plane.Direction != 1 { return moverTransition{Frame: frame} }
    proposed := plane.step(false)
    if context.PlayerHandle == 0 && proposed.Height == plane.Height { return moverTransition{Frame: frame} }
    frame.State = plane.apply(frame.State, proposed.Height)

    blocked := false
    var position MapPositionCheck
    if context.PlayerHandle > 0 {
        change := moveSectorActors(context, frame, plane.Sector, plane.Crush)
        frame, blocked = frame.withActorChange(change, context.PlayerHandle), change.Blocked
    } else {
        position = moverPosition(frame.State.ApplyTo(context.Base), context.Blocks, frame.Player)
        frame.Valid = position.Valid
        blocked = position.Ceiling - position.Floor < frame.Player.Height
    }
    if !frame.Valid { return moverTransition{Frame: frame, Blocked: blocked} }

    moved := plane.step(blocked)
    if moved.RolledBack {
        frame.State = plane.apply(frame.State, moved.Height)
        if context.PlayerHandle > 0 {
            change := moveSectorActors(context, frame, plane.Sector, plane.Crush)
            frame = frame.withActorChange(change, context.PlayerHandle)
        }
    }
    if moved.Height != plane.Height {
        frame.Changed = true
        if context.PlayerHandle == 0 { frame.Player = clipMoverPlayer(frame.Player, position) }
    }
    return moverTransition{Frame: frame, Blocked: blocked}
}

func tickDoorMover(context moverContext, frame MoverFrame, handle int) MoverFrame {
    entry := frame.State.Doors.EntryAt(handle)
    before := entry.State
    if !before.Active { return frame }
    before.Floor = frame.State.Floors.heightAt(entry.Sector, before.Floor)
    destination := before.Top
    if before.Direction < 0 { destination = before.Floor }
    moved := moveLevelPlane(context, frame, moverPlane{Sector: entry.Sector, Height: before.Ceiling,
        Destination: destination, Speed: before.Speed, Direction: before.Direction, Ceiling: true})
    frame = moved.Frame
    if !frame.Valid { return frame }
    if frame.State.Doors.EntryAt(handle).Order != entry.Order {
        frame.Valid = false
        return frame
    }
    after := TickDoor(before, moved.Blocked)
    frame.Sounds = frame.Sounds.addTick(entry.Sector, DoorTickSounds(before, after))
    if after.Active {
        frame.State.Doors = frame.State.Doors.WithState(handle, after)
    } else {
        frame.State = frame.State.recordCeilingRelease(entry.Sector, after.Ceiling)
        frame.State.Doors = frame.State.Doors.removeDoor(handle)
    }
    return frame
}

func tickFloorMover(context moverContext, frame MoverFrame, handle int) MoverFrame {
    before := frame.State.Floors.EntryAt(handle)
    if !before.active() { return frame }
    floor := before.Motion
    plane := moverPlane{Sector: before.Sector, Height: floor.Height,
        Destination: floor.Destination, Speed: floor.Speed, Direction: floor.Direction, Crush: floor.Crush}
    if before.Platform.Mode != 0 {
        platform := before.Platform
        plane = moverPlane{Sector: before.Sector, Height: platform.Height, Speed: platform.Speed}
        switch platform.Status {
        case PlatformUp: plane.Direction, plane.Destination = 1, platform.High
        case PlatformDown: plane.Direction, plane.Destination = -1, platform.Low
        }
    }
    moved := moveLevelPlane(context, frame, plane)
    frame = moved.Frame
    if !frame.Valid { return frame }
    live := frame.State.Floors.EntryAt(handle)
    if live.Order != before.Order {
        frame.Valid = false
        return frame
    }
    after := before.advance(moved.Blocked)
    after.Surface = live.Surface
    if before.Platform.Mode != 0 {
        frame.Sounds = frame.Sounds.addTick(before.Sector, PlatformTickSounds(before.Platform, after.Platform, context.LevelTime))
    } else {
        frame.Sounds = frame.Sounds.addTick(before.Sector, FloorTickSounds(before.Motion, after.Motion, context.LevelTime))
    }
    frame.State.Floors = frame.State.Floors.withEntry(handle, after)
    if !after.active() {
        if after.Platform.Mode != 0 { frame.State.Floors.ActivePlatforms = frame.State.Floors.ActivePlatforms - 1 }
        frame.State.Doors.NextMover = frame.State.Doors.NextMover + 1
        if after.OnFinish.Changed {
            frame.State.Floors = frame.State.Floors.withSurface(before.Sector, after.OnFinish)
            frame.State.Floors.Revision = frame.State.Floors.Revision + 1
        }
        frame.State.Floors = frame.State.Floors.retire(handle, frame.State.Doors.NextMover)
    }
    return frame
}

func tickCeilingMover(context moverContext, frame MoverFrame, handle int) MoverFrame {
    entry := frame.State.Ceilings.EntryAt(handle)
    before := entry.Motion
    if !before.Active || before.Direction == 0 { return frame }
    destination := before.Top
    if before.Direction < 0 { destination = before.Bottom }
    moved := moveLevelPlane(context, frame, moverPlane{Sector: entry.Sector, Height: before.Height,
        Destination: destination, Speed: before.Speed, Direction: before.Direction, Ceiling: true,
        Crush: before.Crush && before.Direction < 0})
    frame = moved.Frame
    if !frame.Valid { return frame }
    if frame.State.Ceilings.EntryAt(handle).Order != entry.Order {
        frame.Valid = false
        return frame
    }
    after := TickCeiling(before, moved.Blocked)
    frame.Sounds = frame.Sounds.addTick(entry.Sector, CeilingTickSounds(before, after, context.LevelTime))
    if !after.Active && entry.Tracked {
        frame.State = frame.State.recordCeilingRelease(entry.Sector, after.Height)
        frame.State.Ceilings = frame.State.Ceilings.remove(handle)
        return frame
    }
    // Overflow thinkers are outside activeceilings and cannot unlink themselves.
    after.Active = true
    frame.State.Ceilings = frame.State.Ceilings.WithMotion(handle, after)
    return frame
}

func (lights LevelLights) nextThinker(start int, order int) int {
    for offset := range lights.Count - start {
        index := start + offset
        entry := lights.EntryAt(index)
        if entry.Kind != SectorLightInactive && entry.Order > order { return index }
    }
    return lights.Count
}

type SectorThinkerCursor struct {
    door int
    floor int
    ceiling int
    light int
    after int
    clock int
    started bit
}

type SectorThinker struct {
    Valid bit
    Order int
    Next SectorThinkerCursor
    kind int
    index int
}

// Walk to the end of the registered thinkers. Fletcher enforces the script
// work budget while the signed registration order bounds the traversal.
const ThinkerIterationLimit = 2147483647
const sectorDoorThinker = 1
const sectorFloorThinker = 2
const sectorCeilingThinker = 3
const sectorLightThinker = 4

// The caller advances Next only after this callback actually ran.
func (state LevelSpecials) NextSectorThinker(cursor SectorThinkerCursor) SectorThinker {
    if !cursor.started {
        cursor.after, cursor.clock, cursor.started = -1, state.Doors.NextMover, true
        cursor.door = state.Doors.First()
        cursor.floor = state.Floors.First()
        cursor.ceiling = state.Ceilings.thinkers.first
    } else if cursor.clock != state.Doors.NextMover {
        // A callback may remove a thinker or append after the old tail.
        cursor.clock = state.Doors.NextMover
        cursor.door = state.Doors.thinkers.afterOrder(cursor.after, state.Doors.Count)
        cursor.floor = state.Floors.thinkers.afterOrder(cursor.after, state.Floors.Count)
        cursor.ceiling = state.Ceilings.thinkers.afterOrder(cursor.after, state.Ceilings.Count)
        cursor.light = state.Lighting.Lights.nextThinker(0, cursor.after)
    }
    lights := state.Lighting.Lights
    if cursor.light < lights.Count && lights.EntryAt(cursor.light).Kind == SectorLightInactive {
        cursor.light = lights.nextThinker(cursor.light, cursor.after)
    }
    const noThinker = 2147483647
    doorOrder, floorOrder, ceilingOrder, lightOrder := noThinker, noThinker, noThinker, noThinker
    if cursor.door > 0 { doorOrder = state.Doors.EntryAt(cursor.door).Order }
    if cursor.floor > 0 { floorOrder = state.Floors.EntryAt(cursor.floor).Order }
    if cursor.ceiling > 0 { ceilingOrder = state.Ceilings.EntryAt(cursor.ceiling).Order }
    if cursor.light < lights.Count { lightOrder = lights.EntryAt(cursor.light).Order }
    if doorOrder == noThinker && floorOrder == noThinker && ceilingOrder == noThinker && lightOrder == noThinker {
        return SectorThinker{Next: cursor}
    }
    picked := SectorThinker{Valid: true}
    if lightOrder < doorOrder && lightOrder < floorOrder && lightOrder < ceilingOrder {
        picked.Order, picked.kind, picked.index = lightOrder, sectorLightThinker, cursor.light
        cursor.light = cursor.light + 1
    } else if doorOrder <= floorOrder && doorOrder <= ceilingOrder {
        picked.Order, picked.kind, picked.index = doorOrder, sectorDoorThinker, cursor.door
        cursor.door = state.Doors.Following(cursor.door)
    } else if floorOrder <= ceilingOrder {
        picked.Order, picked.kind, picked.index = floorOrder, sectorFloorThinker, cursor.floor
        cursor.floor = state.Floors.Following(cursor.floor)
    } else {
        picked.Order, picked.kind, picked.index = ceilingOrder, sectorCeilingThinker, cursor.ceiling
        cursor.ceiling = state.Ceilings.thinkers.slotAt(cursor.ceiling).Following
    }
    cursor.after = picked.Order
    picked.Next = cursor
    return picked
}

func tickSectorThinker(context moverContext, frame MoverFrame, picked SectorThinker) MoverFrame {
    if frame.State.LimitExceeded() { frame.Valid = false; return frame }
    if context.PlayerHandle > 0 {
        frame.State = frame.State.WithActorOrder(frame.World.Actors)
        frame.World.Actors = frame.World.Actors.WithSectorOrder(frame.State)
        frame.State.Lighting.Random = frame.World.Random
    }
    switch picked.kind {
    case sectorDoorThinker: frame = tickDoorMover(context, frame, picked.index)
    case sectorFloorThinker: frame = tickFloorMover(context, frame, picked.index)
    case sectorCeilingThinker: frame = tickCeilingMover(context, frame, picked.index)
    case sectorLightThinker:
        frame.State.Lighting = frame.State.Lighting.tickThinker(picked.index)
        if context.PlayerHandle > 0 { frame.World.Random = frame.State.Lighting.Random }
    }
    if context.PlayerHandle > 0 {
        frame.State = frame.State.WithActorOrder(frame.World.Actors)
        frame.World.Actors = frame.World.Actors.WithSectorOrder(frame.State)
    }
    if frame.State.LimitExceeded() { frame.Valid = false }
    return frame
}

func TickSectorThinkerWithActors(base wad.BspLevel, blocks wad.BlockMapInfo, frame MoverFrame,
    picked SectorThinker, playerHandle int, levelTime int, rules CombatRules, actions WalkoverTelefrag) MoverFrame {
    context := moverContext{Base: base, Blocks: blocks, PlayerHandle: playerHandle, LevelTime: levelTime, Rules: rules, Actions: actions}
    return tickSectorThinker(context, frame, picked)
}

// The sector-only callers use the same cursor as the mixed preview queue.
func tickLevelMovers(context moverContext, frame MoverFrame) MoverFrame {
    if frame.State.LimitExceeded() { frame.Valid = false; return frame }
    var cursor SectorThinkerCursor
    for range ThinkerIterationLimit {
        picked := frame.State.NextSectorThinker(cursor)
        if !picked.Valid { return frame }
        frame = tickSectorThinker(context, frame, picked)
        if !frame.Valid { return frame }
        cursor = picked.Next
    }
    frame.Valid = false
    return frame
}

func TickLevelMovers(base wad.BspLevel, blocks wad.BlockMapInfo, state LevelSpecials, player MapActor) MoverFrame {
    frame := TickLevelMoversAt(base, blocks, state, player, 0)
    if frame.Valid { frame.State.Doors = frame.State.Doors.TickButtonTimers(base) }
    return frame
}

func TickLevelMoversAt(base wad.BspLevel, blocks wad.BlockMapInfo, state LevelSpecials, player MapActor, levelTime int) MoverFrame {
    return tickLevelMovers(moverContext{Base: base, Blocks: blocks, LevelTime: levelTime},
        MoverFrame{Valid: true, State: state, Player: player})
}

func TickLevelMoversWithActors(base wad.BspLevel, blocks wad.BlockMapInfo, state LevelSpecials, world CombatWorld,
    playerHandle int, levelTime int, rules CombatRules, actions WalkoverTelefrag) MoverFrame {
    actor := world.Actors.ActorAt(playerHandle - 1)
    if !actor.Valid || !blocks.Valid { return MoverFrame{State: state, World: world} }
    state.Lighting.Random = world.Random
    context := moverContext{Base: base, Blocks: blocks, PlayerHandle: playerHandle, LevelTime: levelTime, Rules: rules, Actions: actions}
    return tickLevelMovers(context, MoverFrame{Valid: true, State: state, World: world, Player: actor.Physics.Body})
}
