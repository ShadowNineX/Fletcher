package play

import "actorinfo"
import "engine"
import "numeric"
import "wad"

const ActorJustHit = 0x40
const CheatGodMode = 2
const BaseThreshold = 100

const combatAfterPain = 1
const combatAfterDeath = 2
const combatAfterExplosion = 3

type CombatWorld struct {
    Actors MapActors
    Links ActorLinks
    Players [wad.VanillaPlayers]PlayerInventory
    Random RandomState
    AttackRange int
    Position PositionQuery
}

// P_CheckPosition and P_TeleportMove share these p_map.c globals. An
// immediate state action can replace them before its caller resumes.
type PositionQuery struct {
    Thing int
    X int
    Y int
    Floor int
    Ceiling int
    CeilingLine int
}

func (world CombatWorld) WithPositionCheck(handle int, x int, y int, check MapPositionCheck) CombatWorld {
    world.Position = PositionQuery{Thing: handle, X: x, Y: y, Floor: check.Floor, Ceiling: check.Ceiling,
        CeilingLine: check.CeilingLine}
    return world
}

type CombatRules struct {
    Skill int
    Fast bit
    ConsolePlayer int
    Automap bit
}

type DamageRequest struct {
    Target int
    Inflictor int
    Source int
    Amount int
}

type CombatFeedback struct {
    Tactile int
    LowerWeapon int
    CloseAutomap bit
    DroppedActor int
    Sound int
    SoundOrigin int
}

type CombatStep struct {
    World CombatWorld
    ActorHandle int
    State ActorStateStep
    Feedback CombatFeedback
    Failed bit
    phase int
    source int
    skullImpact bit
}

func combatPlayer(actor LevelActor) int {
    if !actor.Valid || !actor.Physics.Body.Player || actor.PlayerSlot < 0 || actor.PlayerSlot >= wad.VanillaPlayers { return -1 }
    return actor.PlayerSlot
}

func publishCombatState(result CombatStep, actorHandle int, state ActorStateStep, phase int) CombatStep {
    result.World.Actors = result.World.Actors.WithActor(actorHandle, state.Actor)
    if state.Removed { result.World.Links = result.World.Links.UnlinkActor(actorHandle) }
    result.ActorHandle, result.State, result.phase = actorHandle, state, phase
    result.Failed = state.Failed
    return result
}

func dropFor(kind int) int {
    switch kind {
    case actorinfo.ActorWolfSS, actorinfo.ActorPossessed: return actorinfo.ActorClip
    case actorinfo.ActorShotGuy: return actorinfo.ActorShotgun
    case actorinfo.ActorChainGuy: return actorinfo.ActorChaingun
    default: return -1
    }
}

func beginKill(result CombatStep, request DamageRequest, target LevelActor, info actorinfo.ActorDef, rules CombatRules) CombatStep {
    target.Physics.Body.Flags = (target.Physics.Body.Flags & ~bits<32>(ActorShootable | MoveFloat | MoveSkullFly)) | (MoveCorpse | MoveDropoff)
    if target.Kind != actorinfo.ActorSkull { target.Physics.Body.Flags = target.Physics.Body.Flags & ~bits<32>(MoveNoGravity) }
    target.Physics.Body.Height = target.Physics.Body.Height >> 2
    targetPlayer := combatPlayer(target)
    sourcePlayer := combatPlayer(result.World.Actors.ActorAt(request.Source - 1))
    if sourcePlayer >= 0 {
        if target.Physics.Body.Flags & ActorCountKill != 0 {
            result.World.Players[sourcePlayer].KillCount = result.World.Players[sourcePlayer].KillCount + 1
        }
        if targetPlayer >= 0 {
            result.World.Players[sourcePlayer].Frags[targetPlayer] = result.World.Players[sourcePlayer].Frags[targetPlayer] + 1
        }
    } else if target.Physics.Body.Flags & ActorCountKill != 0 {
        result.World.Players[0].KillCount = result.World.Players[0].KillCount + 1
    }
    if targetPlayer >= 0 {
        if request.Source == 0 {
            result.World.Players[targetPlayer].Frags[targetPlayer] = result.World.Players[targetPlayer].Frags[targetPlayer] + 1
        }
        target.Physics.Body.Flags = target.Physics.Body.Flags & ~bits<32>(ActorSolid)
        result.World.Players[targetPlayer].Dead = true
        result.Feedback.LowerWeapon = targetPlayer + 1
        result.Feedback.CloseAutomap = rules.Automap && targetPlayer == rules.ConsolePlayer
    }

    state := info.DeathState
    if target.Health < -info.SpawnHealth && info.XDeathState != ActorNullState { state = info.XDeathState }
    return publishCombatState(result, request.Target, SetMobjStateWithFast(target, state, rules.Fast), combatAfterDeath)
}

func prepareDamage(level wad.BspLevel, world CombatWorld, request DamageRequest, rules CombatRules) CombatStep {
    result := CombatStep{World: world, ActorHandle: request.Target, source: request.Source}
    target := world.Actors.ActorAt(request.Target - 1)
    if !target.Valid || target.Health <= 0 || target.Physics.Body.Flags & ActorShootable == 0 { return result }
    info := actorinfo.KindAt(target.Kind)
    if !info.Valid { result.Failed = true; return result }
    if target.Physics.Body.Flags & MoveSkullFly != 0 {
        target.Physics.MomentumX, target.Physics.MomentumY, target.Physics.MomentumZ = 0, 0, 0
    }
    damage := request.Amount
    slot := combatPlayer(target)
    if slot >= 0 && rules.Skill == 0 { damage = damage >> 1 }
    inflictor := world.Actors.ActorAt(request.Inflictor - 1)
    sourcePlayer := combatPlayer(world.Actors.ActorAt(request.Source - 1))
    if inflictor.Valid && target.Physics.Body.Flags & MoveNoClip == 0 {
        allowThrust := true
        if sourcePlayer >= 0 { allowThrust = world.Players[sourcePlayer].ReadyWeapon != WeaponChainsaw }
        if allowThrust {
            if info.Mass <= 0 { result.Failed = true; return result }
            hit, body := inflictor.Physics.Body, target.Physics.Body
            angle := engine.PointToAngle(hit.X, hit.Y, body.X, body.Y)
            thrust := damage * (engine.FracUnit / 8) * 100 / info.Mass
            if damage < 40 && damage > target.Health && body.Z - hit.Z > 64 * engine.FracUnit {
                roll := PRandom(result.World.Random)
                result.World.Random = roll.State
                if roll.Value & 1 != 0 {
                    angle = angle + 0x80000000
                    thrust = thrust * 4
                }
            }
            target.Physics.MomentumX = target.Physics.MomentumX + cport.C_FixedMul(thrust, engine.AngleCosine(angle))
            target.Physics.MomentumY = target.Physics.MomentumY + cport.C_FixedMul(thrust, engine.AngleSine(angle))
        }
    }
    if slot >= 0 {
        player := result.World.Players[slot]
        if level.SectorSpecial(target.Sector) == 11 && damage >= target.Health { damage = target.Health - 1 }
        if damage < 1000 && (player.Cheats & CheatGodMode != 0 || player.Powers[PowerInvulnerability] != 0) {
            result.World.Actors = result.World.Actors.WithActor(request.Target, target)
            return result
        }
        if player.ArmorType != 0 {
            saved := damage / 2
            if player.ArmorType == 1 { saved = damage / 3 }
            if player.Armor <= saved { saved, player.ArmorType = player.Armor, 0 }
            player.Armor, damage = player.Armor - saved, damage - saved
        }
        player.Health, player.Attacker = player.Health - damage, request.Source
        if player.Health < 0 { player.Health = 0 }
        player.DamageCount = player.DamageCount + damage
        if player.DamageCount > 100 { player.DamageCount = 100 }
        result.World.Players[slot] = player
        if slot == rules.ConsolePlayer {
            tactile := damage
            if tactile > 100 { tactile = 100 }
            result.Feedback.Tactile = 40 + tactile * 2
        }
    }
    target.Health = target.Health - damage
    target.Damaged = true
    if target.Health <= 0 { return beginKill(result, request, target, info, rules) }

    roll := PRandom(result.World.Random)
    result.World.Random = roll.State
    if int(roll.Value) < info.PainChance && target.Physics.Body.Flags & MoveSkullFly == 0 {
        target.Physics.Body.Flags = target.Physics.Body.Flags | ActorJustHit
        return publishCombatState(result, request.Target, SetMobjStateWithFast(target, info.PainState, rules.Fast), combatAfterPain)
    }
    result.World.Actors = result.World.Actors.WithActor(request.Target, target)
    result.phase = combatAfterPain
    return result
}

func wakeTarget(result CombatStep, target LevelActor, rules CombatRules) CombatStep {
    target.ReactionTime = 0
    source := result.World.Actors.ActorAt(result.source - 1)
    if (target.Threshold == 0 || target.Kind == actorinfo.ActorVile) &&
        source.Valid && result.source != result.ActorHandle && source.Kind != actorinfo.ActorVile {
        target.Target, target.Threshold = result.source, BaseThreshold
        info := actorinfo.KindAt(target.Kind)
        if target.State == info.SpawnState && info.SeeState != ActorNullState {
            return publishCombatState(result, result.ActorHandle, SetMobjStateWithFast(target, info.SeeState, rules.Fast), 0)
        }
    }
    result.World.Actors = result.World.Actors.WithActor(result.ActorHandle, target)
    return result
}

func addDeathDrop(level wad.BspLevel, result CombatStep, target LevelActor, rules CombatRules) CombatStep {
    kind := dropFor(target.Kind)
    if kind < 0 { return result }
    handle := result.World.Actors.NextTransientHandle()
    if handle == 0 { result.Failed = true; return result }
    body := target.Physics.Body
    drop := SpawnMobjWithFast(level, kind, body.X, body.Y, ActorOnFloor, rules.Skill, rules.Fast, result.World.Random)
    drop.Actor.Physics.Body.Flags = drop.Actor.Physics.Body.Flags | PickupDropped
    linked := result.World.Links.SetActorPosition(level, handle, drop.Actor)
    if !linked.Valid { result.Failed = true; return result }
    result.World.Actors = result.World.Actors.AppendTransient(linked.Actor)
    result.World.Links, result.World.Random = linked.Links, drop.Random
    result.Feedback.DroppedActor = handle
    return result
}

// Finish deterministic work only after the outstanding state action has run.
// Death tics and item allocation therefore draw RNG after any entry action.
func finishCombat(level wad.BspLevel, result CombatStep, rules CombatRules) CombatStep {
    if result.Failed || result.State.Action != 0 { return result }
    phase := result.phase
    result.phase = 0
    if phase != 0 {
        target := result.World.Actors.ActorAt(result.ActorHandle - 1)
        switch phase {
        case combatAfterPain:
            result = wakeTarget(result, target, rules)
        case combatAfterDeath, combatAfterExplosion:
            roll := PRandom(result.World.Random)
            result.World.Random = roll.State
            target.Tics = target.Tics - int(roll.Value & 3)
            if target.Tics < 1 { target.Tics = 1 }
            if phase == combatAfterExplosion {
                target.Physics.Body.Flags = target.Physics.Body.Flags & ~bits<32>(MoveMissile)
                sound := actorinfo.KindAt(target.Kind).DeathSound
                if sound != 0 { result.Feedback.Sound, result.Feedback.SoundOrigin = sound, result.ActorHandle }
            }
            result.World.Actors = result.World.Actors.WithActor(result.ActorHandle, target)
            if phase == combatAfterDeath { result = addDeathDrop(level, result, target, rules) }
        }
    }
    if !result.Failed && result.State.Action == 0 && result.skullImpact {
        // PIT_CheckThing reads tmthing again after P_DamageMobj returns.
        // An immediate state action can have checked another actor's position.
        handle := result.World.Position.Thing
        result.skullImpact = false
        actor := result.World.Actors.ActorAt(handle - 1)
        actor.Physics.Body.Flags = actor.Physics.Body.Flags & ~bits<32>(MoveSkullFly)
        actor.Physics.MomentumX, actor.Physics.MomentumY, actor.Physics.MomentumZ = 0, 0, 0
        return publishCombatState(result, handle, SetMobjStateWithFast(actor, actorinfo.KindAt(actor.Kind).SpawnState, rules.Fast), 0)
    }
    return result
}

func DamageMobj(level wad.BspLevel, world CombatWorld, request DamageRequest, rules CombatRules) CombatStep {
    return finishCombat(level, prepareDamage(level, world, request, rules), rules)
}

// Uses the RNG that ScanThingContacts returned. The caller processes the
// missile's blocked-move explosion after the damage and its actions finish.
func ApplyThingImpact(level wad.BspLevel, world CombatWorld, mover int, contact ThingContact, rules CombatRules) CombatStep {
    if contact.Action != ContactDamage && contact.Action != ContactSkull { return CombatStep{World: world} }
    world.Position.Thing = mover
    result := prepareDamage(level, world, DamageRequest{Target: contact.Target, Inflictor: mover,
        Source: contact.Source, Amount: contact.Damage}, rules)
    result.skullImpact = contact.Action == ContactSkull
    return finishCombat(level, result, rules)
}

func ExplodeMissile(level wad.BspLevel, world CombatWorld, handle int, rules CombatRules) CombatStep {
    actor := world.Actors.ActorAt(handle - 1)
    if !actor.Valid { return CombatStep{World: world} }
    actor.Physics.MomentumX, actor.Physics.MomentumY, actor.Physics.MomentumZ = 0, 0, 0
    state := SetMobjStateWithFast(actor, actorinfo.KindAt(actor.Kind).DeathState, rules.Fast)
    return finishCombat(level, publishCombatState(CombatStep{World: world}, handle, state, combatAfterExplosion), rules)
}

// Publish the action's changes to result.World before resuming. This includes
// random draws and changes to actors other than the one running the action.
func ResumeMobjCombat(level wad.BspLevel, result CombatStep, rules CombatRules) CombatStep {
    if result.State.Action == 0 || result.Failed { return result }
    current := result.World.Actors.ActorAt(result.ActorHandle - 1)
    state := ResumeMobjStateWithFast(result.State, current, rules.Fast)
    result.Feedback = CombatFeedback{}
    return finishCombat(level, publishCombatState(result, result.ActorHandle, state, result.phase), rules)
}
