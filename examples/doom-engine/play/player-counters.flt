// The live player counter and colormap updates from linuxdoom-1.10/p_user.c.

package play

const inversePlayerColormap = 32
const powerBlinkTics = 4 * 32

func powerColormapOn(tics int, blink bytes) bit {
    if tics >= 0 && tics < len(blink) { return blink[tics] != 0 }
    return tics > powerBlinkTics || tics & 8 != 0
}

func TickLivePlayerCounters(world CombatWorld, handle int) CombatWorld {
    var blink bytes
    return TickLivePlayerCountersWithBlink(world, handle, blink)
}

func TickLivePlayerCountersWithBlink(world CombatWorld, handle int, blink bytes) CombatWorld {
    actor := world.Actors.ActorAt(handle - 1)
    slot := combatPlayer(actor)
    if slot < 0 { return world }
    player := world.Players[slot]
    if player.Powers[PowerStrength] != 0 { player.Powers[PowerStrength] = player.Powers[PowerStrength] + 1 }
    if player.Powers[PowerInvulnerability] != 0 { player.Powers[PowerInvulnerability] = player.Powers[PowerInvulnerability] - 1 }
    if player.Powers[PowerInvisibility] != 0 {
        player.Powers[PowerInvisibility] = player.Powers[PowerInvisibility] - 1
        if player.Powers[PowerInvisibility] == 0 {
            actor.Physics.Body.Flags = actor.Physics.Body.Flags & ~bits<32>(ActorShadow)
            world.Actors = world.Actors.WithActor(handle, actor)
        }
    }
    if player.Powers[PowerInfrared] != 0 { player.Powers[PowerInfrared] = player.Powers[PowerInfrared] - 1 }
    if player.Powers[PowerIronFeet] != 0 { player.Powers[PowerIronFeet] = player.Powers[PowerIronFeet] - 1 }
    if player.DamageCount != 0 { player.DamageCount = player.DamageCount - 1 }
    if player.BonusCount != 0 { player.BonusCount = player.BonusCount - 1 }

    player.FixedColormap = 0
    if player.Powers[PowerInvulnerability] != 0 {
        tics := player.Powers[PowerInvulnerability]
        if powerColormapOn(tics, blink) { player.FixedColormap = inversePlayerColormap }
    } else {
        tics := player.Powers[PowerInfrared]
        if powerColormapOn(tics, blink) { player.FixedColormap = 1 }
    }
    world.Players[slot] = player
    return world
}
