package play

const SectorLightInactive = 0
const SectorLightFlash = 1
const SectorLightStrobe = 2
const SectorLightGlow = 3
const SectorLightFire = 4

const StrobeBright = 5
const StrobeFastDark = 15
const StrobeSlowDark = 35
const GlowSpeed = 8

// SectorLight is a serializable p_lights thinker. The owning level applies
// Level back to the sector named by Sector after every TickSectorLight call.
type SectorLight struct {
    Sector int
    Order int
    Kind int
    Level int
    Max int
    Min int
    Count int
    Dark int
    Bright int
    Direction int
    // P_SpawnSpecials clears spawned light specials, except 4 remains the
    // damaging death-slime sector while its strobe thinker runs.
    Special int
}

type SectorLightStep struct {
    Light SectorLight
    Random RandomState
}

func sectorLightKind(special int) int {
    switch special {
    case 1: return SectorLightFlash
    case 2, 3, 4, 12, 13: return SectorLightStrobe
    case 8: return SectorLightGlow
    case 17: return SectorLightFire
    }
    return SectorLightInactive
}

// SpawnSectorLight is P_SpawnSpecials' p_lights subset. neighboringMin is
// P_FindMinSurroundingLight(sector, initial), supplied by the map layer.
func SpawnSectorLight(sector int, special int, initial int, neighboringMin int, random RandomState) SectorLightStep {
    light := SectorLight{Sector: sector, Kind: sectorLightKind(special), Level: initial}
    if light.Kind == SectorLightInactive {
        light.Special = special
        return SectorLightStep{Light: light, Random: random}
    }
    light.Max, light.Min = initial, neighboringMin
    switch light.Kind {
    case SectorLightFlash:
        roll := PRandom(random)
        light.Count, random = (int(roll.Value) & 64) + 1, roll.State
    case SectorLightStrobe:
        light.Count, light.Dark, light.Bright = 1, StrobeFastDark, StrobeBright
        if special == 3 || special == 12 { light.Dark = StrobeSlowDark }
        if light.Min == light.Max { light.Min = 0 }
        if special < 12 {
            roll := PRandom(random)
            light.Count, random = (int(roll.Value) & 7) + 1, roll.State
        }
        if special == 4 { light.Special = special }
    case SectorLightGlow:
        light.Direction = -1
    case SectorLightFire:
        light.Min, light.Count = neighboringMin + 16, 4
    }
    return SectorLightStep{Light: light, Random: random}
}

func TickSectorLight(light SectorLight, random RandomState) SectorLightStep {
    if light.Kind == SectorLightInactive { return SectorLightStep{Light: light, Random: random} }
    if light.Kind == SectorLightGlow { return tickGlow(light, random) }

    light.Count = light.Count - 1
    if light.Count != 0 { return SectorLightStep{Light: light, Random: random} }
    switch light.Kind {
    case SectorLightFlash: return tickFlash(light, random)
    case SectorLightStrobe: return tickStrobe(light, random)
    case SectorLightFire: return tickFire(light, random)
    }
    return SectorLightStep{Light: light, Random: random}
}

func tickFlash(light SectorLight, random RandomState) SectorLightStep {
    roll := PRandom(random)
    if light.Level == light.Max {
        light.Level, light.Count = light.Min, (int(roll.Value) & 7) + 1
    } else {
        light.Level, light.Count = light.Max, (int(roll.Value) & 64) + 1
    }
    return SectorLightStep{Light: light, Random: roll.State}
}

func tickStrobe(light SectorLight, random RandomState) SectorLightStep {
    if light.Level == light.Min {
        light.Level, light.Count = light.Max, light.Bright
    } else {
        light.Level, light.Count = light.Min, light.Dark
    }
    return SectorLightStep{Light: light, Random: random}
}

func tickFire(light SectorLight, random RandomState) SectorLightStep {
    roll := PRandom(random)
    amount := (int(roll.Value) & 3) * 16
    if light.Level - amount < light.Min {
        light.Level = light.Min
    } else {
        light.Level = light.Max - amount
    }
    light.Count = 4
    return SectorLightStep{Light: light, Random: roll.State}
}

func tickGlow(light SectorLight, random RandomState) SectorLightStep {
    if light.Direction == -1 {
        light.Level = light.Level - GlowSpeed
        if light.Level <= light.Min {
            light.Level = light.Level + GlowSpeed
            light.Direction = 1
        }
    } else if light.Direction == 1 {
        light.Level = light.Level + GlowSpeed
        if light.Level >= light.Max {
            light.Level = light.Level - GlowSpeed
            light.Direction = -1
        }
    }
    return SectorLightStep{Light: light, Random: random}
}
